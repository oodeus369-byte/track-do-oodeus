// [R13-port] Navegação entre páginas (mesmo contrato do goPage do nav.js).
// Os 4 onclick do body chamam goPage (seams R13) — a ponte de nomes do
// wrapper (render-util.runPageScripts) expõe esta função para window.
function goPage(dest) {
  if (window.__CT_NAV_GO_PAGE) { window.__CT_NAV_GO_PAGE(dest); return; }
  window.location.href = dest;
}
const CATALOG_URL = 'https://raw.githubusercontent.com/michel-softwares/Editais-Premium/main/catalog.json';
const CACHE_KEY = 'ct_premium_catalog_cache_v1';
const MATERIALS_CACHE_KEY = 'ct_premium_materials_cache_v3';
let catalogItems = [];
let catalogMeta = {};
let selectedId = '';
let installingId = '';
let installStage = '';
let loadingDetailsId = '';
let detailsCache = {};
let examHydrationToken = 0;
let materialHydrationToken = 0;
let examRefreshTimer = 0;
let manualContent = '';
let manualName = '';
let manualSize = 0;
let installedModalHistoryActive = false;
let requestModalHistoryActive = false;

const MATERIAL_PROVIDERS = [
  { key:'qconcursos', label:'Qconcursos', headline:'Com cadernos de questões do Qconcursos', logo:__ctAssetUrl('assets/material-logos/qconcursos.png') },
  { key:'tec', label:'Tec Concursos', headline:'Com cadernos de questões do Tec Concursos', logo:'' },
  { key:'estrategia', label:'Estratégia Concursos', headline:'Com materiais do Estratégia Concursos', logo:__ctAssetUrl('assets/material-logos/estrategia.png') },
  { key:'youtube', label:'YouTube', headline:'Com videoaulas do YouTube', logo:__ctAssetUrl('assets/material-logos/youtube.png') },
  { key:'google-drive', label:'Google Drive', headline:'Com materiais do Google Drive', logo:'' },
  { key:'generic', label:'Materiais linkados', headline:'Com materiais de estudo linkados', logo:'' }
];

function escapeHtml(value){
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
}
function normalizeText(value){
  return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
}
function normalizedLoose(value){
  return normalizeText(value).replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
}
function sameLooseText(a, b){
  const x = normalizedLoose(a);
  const y = normalizedLoose(b);
  if (!x || !y) return false;
  if (x === y) return true;
  return (x.length >= 9 && y.includes(x)) || (y.length >= 9 && x.includes(y));
}
function formatPremiumBanca(value){
  const raw = String(value || '').trim().replace(/\s+/g, ' ');
  if (!raw || normalizedLoose(raw) === 'a definir') return 'A definir';
  return raw.toLocaleUpperCase('pt-BR');
}
function premiumBancaKey(value){
  return normalizedLoose(formatPremiumBanca(value)) || 'a definir';
}
function slug(value){
  return normalizeText(value).replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'edital-premium';
}
function titleFromPath(item){
  const source = String(item.imagem || item.arquivo || '').trim();
  if (!source) return '';
  const folder = source.split('/')[0] || '';
  if (!folder) return '';
  try {
    return decodeURIComponent(folder)
      .replace(/\b20\d{2}\b/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  } catch (_) {
    return folder.replace(/\b20\d{2}\b/g, '').replace(/\s+/g, ' ').trim();
  }
}
function withBust(url, version){
  if (!url) return '';
  try {
    const u = new URL(url);
    if (version) u.searchParams.set('v', version);
    return u.href;
  } catch (_) {
    return version ? url + (url.includes('?') ? '&' : '?') + 'v=' + encodeURIComponent(version) : url;
  }
}
function resolveUrl(value, baseUrl, version){
  const raw = String(value || '').trim();
  if (!raw) return '';
  try {
    const resolved = /^https?:\/\//i.test(raw) ? raw : new URL(raw, baseUrl).href;
    return version ? withBust(resolved, version) : resolved;
  } catch (_) {
    return raw;
  }
}
function cleanInstallUrl(url){
  const raw = String(url || '').trim();
  if (!raw) return '';
  try {
    const u = new URL(raw);
    u.search = '';
    u.hash = '';
    return u.href;
  } catch (_) {
    return raw.split('#')[0].split('?')[0];
  }
}
function readMaterialsCache(){
  try {
    const parsed = JSON.parse(localStorage.getItem(MATERIALS_CACHE_KEY) || '{}');
    return parsed && typeof parsed === 'object' ? parsed : {};
  } catch (_) {
    return {};
  }
}
function saveMaterialsCache(cache){
  try { localStorage.setItem(MATERIALS_CACHE_KEY, JSON.stringify(cache || {})); } catch (_) {}
}
function materialCacheKey(item){
  const fileUrl = cleanInstallUrl(item && item.fileUrl);
  const version = String((item && item.atualizadoEm) || (catalogMeta && catalogMeta.updated) || '');
  return fileUrl ? fileUrl + '|' + version : '';
}
function materialProvidersFromKeys(keys){
  const set = new Set((keys || []).map(key => String(key || '').trim()).filter(Boolean));
  return MATERIAL_PROVIDERS.filter(provider => set.has(provider.key));
}
function getMaterialProvider(key){
  return MATERIAL_PROVIDERS.find(provider => provider.key === key) || null;
}
function mergePremiumMaterials(){
  const seen = new Set();
  const output = [];
  Array.from(arguments).flat().forEach(provider => {
    if (!provider || !provider.key || seen.has(provider.key)) return;
    if (provider.key === 'generic' && output.length) return;
    if (provider.key !== 'generic') {
      const genericIndex = output.findIndex(item => item.key === 'generic');
      if (genericIndex >= 0) output.splice(genericIndex, 1);
    }
    seen.add(provider.key);
    output.push(provider);
  });
  return output;
}
function normalizeMaterialProviderKey(value){
  const raw = String(value || '');
  const text = normalizeText(raw);
  const compact = text.replace(/[^a-z0-9]+/g, '');
  if (compact.includes('qconcursos') || compact.includes('qconcurso')) return 'qconcursos';
  if (compact.includes('tecconcursos')) return 'tec';
  if (compact.includes('estrategia') || compact.includes('estratgia') || (compact.includes('estrat') && compact.includes('concursos'))) return 'estrategia';
  if (compact.includes('youtube') || compact.includes('youtu')) return 'youtube';
  if (compact.includes('googledrive') || compact.includes('drivegoogle') || compact.includes('docsgoogle')) return 'google-drive';
  if (text === 'materiais linkados' || text === 'material linkado' || text === 'materiais vinculados') return 'generic';
  return '';
}
function detectPremiumMaterialFromUrl(value){
  const raw = String(value || '').trim();
  if (!raw) return [];
  try {
    const parsed = new URL(raw);
    const host = parsed.hostname.toLowerCase();
    if (host === 'qconcursos.com' || host.endsWith('.qconcursos.com')) return [getMaterialProvider('qconcursos')];
    if (host === 'tecconcursos.com.br' || host.endsWith('.tecconcursos.com.br') || host === 'tecconcursos.com' || host.endsWith('.tecconcursos.com')) return [getMaterialProvider('tec')];
    if (host.includes('estrategia') || host.endsWith('estrategiaconcursos.com.br')) return [getMaterialProvider('estrategia')];
    if (host === 'youtube.com' || host.endsWith('.youtube.com') || host === 'youtu.be') return [getMaterialProvider('youtube')];
    if (host === 'drive.google.com' || host === 'docs.google.com') return [getMaterialProvider('google-drive')];
  } catch (_) {
    return [];
  }
  return [];
}
function detectPremiumMaterialsFromExplicitValue(value){
  if (value == null || value === '') return [];
  const providers = [];
  const addProvider = candidate => {
    const key = normalizeMaterialProviderKey(candidate);
    if (key) providers.push(getMaterialProvider(key));
  };
  if (Array.isArray(value)) {
    value.forEach(entry => {
      if (typeof entry === 'string') {
        const fromUrl = detectPremiumMaterialFromUrl(entry);
        if (fromUrl.length) providers.push(...fromUrl);
        else addProvider(entry);
        return;
      }
      if (entry && typeof entry === 'object') {
        providers.push(...detectPremiumMaterialsFromExplicitValue(entry.provedor || entry.provider || entry.key || entry.tipo || entry.rotulo || entry.nome || entry.label));
        providers.push(...detectPremiumMaterialFromUrl(entry.url || entry.link || entry.href));
      }
    });
    return mergePremiumMaterials(providers.filter(Boolean));
  }
  if (typeof value === 'object') {
    providers.push(...detectPremiumMaterialsFromExplicitValue(value.provedor || value.provider || value.key || value.tipo || value.rotulo || value.nome || value.label));
    providers.push(...detectPremiumMaterialFromUrl(value.url || value.link || value.href));
    return mergePremiumMaterials(providers.filter(Boolean));
  }
  const raw = String(value);
  const urlProviders = detectPremiumMaterialFromUrl(raw);
  if (urlProviders.length) providers.push(...urlProviders);
  raw.split(/[,;|/]+/).forEach(addProvider);
  return mergePremiumMaterials(providers.filter(Boolean));
}
function extractExplicitMaterialsFromText(value){
  const lines = String(value || '').split(/\r?\n/);
  const providers = [];
  lines.forEach(line => {
    const normalized = normalizeText(line);
    if (!/^(materiais?|links?)\s+(de\s+estudo\s+)?(linkados?|vinculados?)\s*:/.test(normalized)) return;
    const valuePart = line.split(':').slice(1).join(':');
    providers.push(...detectPremiumMaterialsFromExplicitValue(valuePart));
  });
  return mergePremiumMaterials(providers.filter(Boolean));
}
function detectPremiumMaterialFromLinkItem(item){
  if (!item) return [];
  if (typeof item === 'string') return detectPremiumMaterialFromUrl(item);
  if (typeof item !== 'object') return [];
  return detectPremiumMaterialFromUrl(item.url || item.link || item.href);
}
function detectPremiumMaterialsFromLinkedData(value){
  let root = value;
  if (typeof value === 'string') {
    try { root = JSON.parse(value); } catch (_) { return []; }
  }
  const providers = [];
  const walk = node => {
    if (!node || typeof node !== 'object') return;
    if (Array.isArray(node)) {
      node.forEach(walk);
      return;
    }
    Object.keys(node).forEach(key => {
      const child = node[key];
      if (key === 'cadernos' && Array.isArray(child)) {
        child.forEach(link => providers.push(...detectPremiumMaterialFromLinkItem(link)));
        return;
      }
      walk(child);
    });
  };
  walk(root);
  return mergePremiumMaterials(providers.filter(Boolean));
}
function inferLevel(item){
  const tags = Array.isArray(item.tags) ? item.tags.join(' ') : '';
  const text = normalizeText([tags, item.cargo, item.descricao, item.titulo, item.orgao, item.detalhesTexto, item.detalhes].join(' '));
  return canonicalLevel(text);
}
function extractLevelFromText(value){
  const text = String(value || '');
  if (!text) return '';
  const lines = text.split(/\r?\n/);
  const preferred = lines.find(line => {
    const normalized = normalizeText(line);
    return normalized.includes('escolaridade') || normalized.includes('requisito') || normalized.includes('nivel') || normalized.includes('ensino');
  });
  const source = preferred || text;
  const level = canonicalLevel(source);
  if (level !== 'Nao informado') return level;
  return '';
}
function canonicalLevel(value){
  const raw = String(value || '').toLowerCase();
  const normalized = normalizeText(value);
  const loose = normalized.replace(/[^a-z0-9]+/g, '');
  if (normalized.includes('fundamental') || raw.includes('fundamental')) return 'Fundamental';
  if (normalized.includes('superior') || raw.includes('superior')) return 'Superior';
  if (loose.includes('medio') || loose.includes('mdio') || loose.includes('madio') || raw.includes('m\u00e9dio') || raw.includes('m\u00e3\u00a9dio') || raw.includes('m\u00c3\u00a9dio')) return 'Medio';
  return 'Nao informado';
}
function displayLevel(value){
  const level = canonicalLevel(value);
  if (level === 'Fundamental') return 'N\u00edvel Fundamental';
  if (level === 'Superior') return 'N\u00edvel Superior';
  if (level === 'Medio') return 'N\u00edvel M\u00e9dio';
  return 'N\u00e3o informado';
}
function normalizePremiumTag(value){
  const label = String(value || '').trim();
  const normalized = normalizeText(label);
  const level = canonicalLevel(label);
  if (!label) return null;
  if (normalized.startsWith('atualizado')) return null;
  if (normalized.includes('nivel')) return null;
  if (level !== 'Nao informado') return null;
  if (normalized === 'medio' || normalized === 'superior' || normalized === 'fundamental') return null;
  if (normalized === 'edital pronto' || normalized === 'edital verticalizado') {
    return { label:'Edital Verticalizado Completo', kind:'' };
  }
  if (normalized === 'edital verticalizado completo') {
    return { label:'Edital Verticalizado Completo', kind:'' };
  }
  if (
    normalized === 'materiais linkados' ||
    normalized === 'material linkado' ||
    normalized === 'links de materiais' ||
    normalized === 'materiais vinculados'
  ) {
    return { label:'Materiais Linkados', kind:'gold' };
  }
  return { label, kind:'' };
}
function buildPremiumTags(item){
  const output = [];
  const seen = new Set();
  const addTag = tag => {
    if (!tag || !tag.label) return;
    const key = normalizeText(tag.label);
    if (!key || seen.has(key)) return;
    seen.add(key);
    output.push(tag);
  };
  addTag({ label:displayLevel(item.level), kind:'' });
  addTag({ label:item.banca, kind:'' });
  addTag({ label:item.ano, kind:'' });
  if (item.materials && item.materials.length) addTag({ label:'Materiais Linkados', kind:'gold' });
  const normalizedTags = (item.tags || []).map(normalizePremiumTag).filter(Boolean);
  normalizedTags.filter(tag => tag.kind === 'gold').forEach(addTag);
  addTag(buildExamDateTag(item));
  normalizedTags.filter(tag => tag.kind !== 'gold').forEach(addTag);
  return output.slice(0, 6);
}
function isDetailsTextPath(value){
  return /\.txt(?:[?#].*)?$/i.test(String(value || '').trim());
}
function detailsNameCandidatesFromSource(source){
  const raw = String(source || '').trim();
  if (!raw) return [];
  const clean = raw.split(/[?#]/)[0];
  const slash = clean.lastIndexOf('/');
  const file = slash >= 0 ? clean.slice(slash + 1) : clean;
  if (!file) return [];
  let decoded = file;
  try { decoded = decodeURIComponent(file); } catch (_) {}
  const stem = decoded.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
  const compact = stem
    .replace(/\bpre\s*edital\b/ig, '')
    .replace(/\bedital\b/ig, '')
    .replace(/\bpremium\b/ig, '')
    .replace(/\btrack\b/ig, '')
    .replace(/\bconcursos\b/ig, '')
    .replace(/\s+/g, ' ')
    .trim();
  const names = [];
  if (compact) {
    names.push('Ficha Informativa ' + compact + '.txt');
    names.push('ficha informativa ' + compact + '.txt');
    names.push(compact + '.txt');
  }
  if (stem && stem !== compact) names.push('Ficha Informativa ' + stem + '.txt');
  return Array.from(new Set(names));
}
function inferDetailsPaths(item){
  const explicitFields = [item.detalhesArquivo, item.detalhesUrl, item.detalhesTxt, item.arquivoDetalhes, item.txt];
  if (isDetailsTextPath(item.detalhes)) explicitFields.push(item.detalhes);
  const source = String(item.arquivo || item.imagem || '').trim();
  const paths = [];
  explicitFields.filter(Boolean).forEach(path => paths.push(String(path)));
  if (!source || /^https?:\/\//i.test(source)) return paths;
  const slash = source.lastIndexOf('/');
  if (slash >= 0) {
    const dir = source.slice(0, slash + 1);
    paths.push(dir + 'detalhes.txt');
    paths.push(dir + '.txt');
    detailsNameCandidatesFromSource(source).forEach(name => paths.push(dir + name));
  }
  return Array.from(new Set(paths.filter(Boolean)));
}
function formatDate(value){
  const date = new Date(value || '');
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric' });
}
function getLocalDateOnly(date = new Date()){
  return new Date(date.getFullYear(), date.getMonth(), date.getDate());
}
function buildValidDate(year, month, day){
  const date = new Date(year, month - 1, day);
  if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) return null;
  return date;
}
function parseExamDate(value){
  if (!value) return null;
  if (value instanceof Date && !Number.isNaN(value.getTime())) return getLocalDateOnly(value);
  const raw = String(value).trim();
  if (!raw || normalizeText(raw).includes('nao informada')) return null;
  const isoMatch = raw.match(/(\d{4})-(\d{2})-(\d{2})/);
  if (isoMatch) return buildValidDate(Number(isoMatch[1]), Number(isoMatch[2]), Number(isoMatch[3]));
  const brMatch = raw.match(/(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})/);
  if (brMatch) return buildValidDate(Number(brMatch[3]), Number(brMatch[2]), Number(brMatch[1]));
  const monthMap = {
    janeiro:1, fevereiro:2, marco:3, abril:4, maio:5, junho:6,
    julho:7, agosto:8, setembro:9, outubro:10, novembro:11, dezembro:12
  };
  const normalizedRaw = normalizeText(raw);
  const longMatch = normalizedRaw.match(/(\d{1,2})\s+de\s+([a-z]+)\s+de\s+(\d{4})/);
  if (longMatch && monthMap[longMatch[2]]) {
    return buildValidDate(Number(longMatch[3]), monthMap[longMatch[2]], Number(longMatch[1]));
  }
  const parsed = new Date(raw);
  if (Number.isNaN(parsed.getTime())) return null;
  return getLocalDateOnly(parsed);
}
function extractExamDateFromText(value){
  const text = String(value || '');
  if (!text) return null;
  const lines = text.split(/\r?\n/);
  for (const line of lines) {
    if (!normalizeText(line).includes('data da prova')) continue;
    const candidate = line.includes(':') ? line.split(':').slice(1).join(':') : line;
    const date = parseExamDate(candidate);
    if (date) return date;
  }
  return null;
}
function parseMoneyBR(value){
  const raw = String(value || '').trim();
  if (!raw) return 0;
  const cleaned = raw.replace(/[^\d.,]/g, '');
  if (!cleaned) return 0;
  const normalized = cleaned.includes(',')
    ? cleaned.replace(/\./g, '').replace(',', '.')
    : cleaned.split('.').length === 2 && cleaned.split('.')[1].length <= 2
      ? cleaned
      : cleaned.replace(/\./g, '');
  const parsed = Number(normalized);
  return Number.isFinite(parsed) ? parsed : 0;
}
function extractSalaryFromText(value){
  const text = String(value || '');
  if (!text) return 0;
  const lines = text.split(/\r?\n/);
  const preferred = lines.find(line => {
    const normalized = normalizeText(line);
    return normalized.includes('remuneracao') || normalized.includes('salario') || normalized.includes('subsidio') || normalized.includes('vencimento');
  });
  const source = preferred || text;
  const moneyMatch = source.match(/R\$\s*([\d.]+(?:,\d{2})?)/i);
  if (moneyMatch) return parseMoneyBR(moneyMatch[1]);
  return 0;
}
function parseSalaryValue(value){
  if (typeof value === 'number' && Number.isFinite(value)) return value;
  if (!value) return 0;
  const text = String(value);
  const moneyMatch = text.match(/R\$\s*([\d.]+(?:,\d{2})?)/i);
  return parseMoneyBR(moneyMatch ? moneyMatch[1] : text);
}
function formatExamDate(date){
  return date.toLocaleDateString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric' });
}
function buildExamDateTag(item){
  const examDate = parseExamDate(item && item.examDate);
  if (!examDate) return null;
  const today = getLocalDateOnly();
  const diffDays = Math.ceil((examDate.getTime() - today.getTime()) / 86400000);
  if (diffDays < 0) {
    return {
      label:'⚠️ A prova desse concurso já aconteceu. Use a estrutura como preparação para o próximo concurso',
      kind:'exam past',
      title:`Data da prova: ${formatExamDate(examDate)}`
    };
  }
  const daysText = diffDays === 0 ? 'Prova hoje' : diffDays === 1 ? '1 dia para a prova' : `${diffDays} dias para a prova`;
  return { label:`⚠️ ${daysText} • ${formatExamDate(examDate)}`, kind:'exam' };
}
function normalizeItem(item, updated){
  const tags = Array.isArray(item.tags) ? item.tags.map(t => String(t || '').trim()).filter(Boolean) : [];
  const version = item.atualizadoEm || updated || '';
  const titulo = String(item.titulo || item.orgao || titleFromPath(item) || item.nome || 'Edital Premium').trim();
  const rawCargo = String(item.cargo || '').trim();
  const cargo = /^ficha informativa/i.test(rawCargo) ? '' : rawCargo;
  const rawBanca = String(item.banca || 'A definir').trim();
  const banca = formatPremiumBanca(rawBanca);
  const bancaKey = premiumBancaKey(rawBanca);
  const orgao = String(item.orgao || '').trim();
  const ano = item.ano ? String(item.ano) : '';
  const descricao = String(item.descricao || '').trim();
  const detalhesTexto = String(item.detalhes || item.detalhesTexto || item.observacoes || item.informacoes || '').trim();
  const detalhesArquivos = inferDetailsPaths(item);
  const id = String(item.id || slug([titulo, cargo, ano].join(' '))).trim();
  const level = canonicalLevel(extractLevelFromText(detalhesTexto) || inferLevel({ ...item, titulo, cargo, orgao, tags, descricao, detalhesTexto }));
  const explicitMaterials = mergePremiumMaterials(
    detectPremiumMaterialsFromExplicitValue(item.materiaisLinkados || item.materialProviders || item.provedoresMateriais || item.materialsLinked),
    detectPremiumMaterialsFromExplicitValue(item.materiais || item.materials),
    extractExplicitMaterialsFromText(detalhesTexto),
    extractExplicitMaterialsFromText(tags.join('\n'))
  );
  const normalized = {
    id,
    titulo,
    cargo,
    rawBanca,
    banca,
    bancaKey,
    orgao,
    ano,
    descricao,
    detalhesTexto,
    tags,
    level,
    examDate: parseExamDate(item.dataProva || item.dataDaProva || item.provaData || item.examDate || item.dataProvaObjetiva || extractExamDateFromText(detalhesTexto)),
    salaryValue: parseSalaryValue(item.salario || item.salarioInicial || item.remuneracao || item.remuneracaoInicial || item.salary || item.vencimento) || extractSalaryFromText(detalhesTexto),
    atualizadoEm: item.atualizadoEm || updated || '',
    imageUrl: resolveUrl(item.imagem, CATALOG_URL, version),
    fileUrl: resolveUrl(item.arquivo, CATALOG_URL, version),
    detailsUrls: detalhesArquivos.map(path => resolveUrl(path, CATALOG_URL, version)).filter(Boolean),
    materials: explicitMaterials,
    materialsHydrated: false
  };
  normalized.search = normalizeText([titulo, cargo, banca, orgao, ano, level, tags.join(' ')].join(' '));
  return normalized;
}
function readCache(){
  try { return JSON.parse(localStorage.getItem(CACHE_KEY) || 'null'); } catch (_) { return null; }
}
function saveCache(data){
  try { localStorage.setItem(CACHE_KEY, JSON.stringify(data)); } catch (_) {}
}
async function fetchDetailsText(item){
  const urls = Array.isArray(item && item.detailsUrls) ? item.detailsUrls : [];
  for (const url of urls) {
    const res = await fetch(withBust(url, Date.now()), { cache:'no-store' });
    if (res.ok) return await res.text();
  }
  return '';
}
async function hydrateExamDates(items, token){
  const targets = (Array.isArray(items) ? items : []).filter(item => item && (!item.examDate || !item.salaryValue || canonicalLevel(item.level) === 'Nao informado') && Array.isArray(item.detailsUrls) && item.detailsUrls.length);
  if (!targets.length) return;
  let changed = false;
  await Promise.allSettled(targets.map(async item => {
    const text = detailsCache[item.id] || item.detalhesTexto || await fetchDetailsText(item);
    if (token !== examHydrationToken || !text) return;
    if (!detailsCache[item.id]) detailsCache[item.id] = text;
    const examDate = extractExamDateFromText(text);
    if (examDate && !item.examDate) {
      item.examDate = examDate;
      changed = true;
    }
    const salaryValue = extractSalaryFromText(text);
    if (salaryValue && !item.salaryValue) {
      item.salaryValue = salaryValue;
      changed = true;
    }
    const extractedLevel = extractLevelFromText(text);
    const level = extractedLevel ? canonicalLevel(extractedLevel) : '';
    if (level && canonicalLevel(item.level) !== level) {
      item.level = level;
      item.search = normalizeText([item.titulo, item.cargo, item.banca, item.orgao, item.ano, item.level, (item.tags || []).join(' ')].join(' '));
      changed = true;
    }
    const explicitMaterials = extractExplicitMaterialsFromText(text);
    const mergedMaterials = mergePremiumMaterials(item.materials || [], explicitMaterials);
    if (mergedMaterials.length !== (item.materials || []).length) {
      item.materials = mergedMaterials;
      changed = true;
    }
  }));
  if (changed && token === examHydrationToken) {
    renderFilters();
    renderCatalog();
  }
}
async function hydratePremiumMaterials(items, token){
  const list = Array.isArray(items) ? items : [];
  if (!list.length) return;
  const cache = readMaterialsCache();
  let changedFromCache = false;
  list.forEach(item => {
    const key = materialCacheKey(item);
    if (!key || !Array.isArray(cache[key])) return;
    const cachedMaterials = materialProvidersFromKeys(cache[key]);
    const merged = mergePremiumMaterials(item.materials || [], cachedMaterials);
    if (merged.length !== (item.materials || []).length) {
      item.materials = merged;
      changedFromCache = true;
    }
    item.materialsHydrated = true;
  });
  if (changedFromCache && token === materialHydrationToken) renderCatalog();

  const targets = list.filter(item => item && item.fileUrl && !item.materialsHydrated);
  if (!targets.length) return;
  let changed = false;
  let cacheChanged = false;
  await Promise.allSettled(targets.map(async item => {
    const key = materialCacheKey(item);
    try {
      const res = await fetch(withBust(item.fileUrl, (item.atualizadoEm || catalogMeta.updated || Date.now())), { cache:'no-store' });
      if (!res.ok || token !== materialHydrationToken) return;
      const text = await res.text();
      if (token !== materialHydrationToken) return;
      let detailsText = item.detalhesTexto || detailsCache[item.id] || '';
      if (!detailsText && Array.isArray(item.detailsUrls) && item.detailsUrls.length) {
        try {
          detailsText = await fetchDetailsText(item);
          if (detailsText) detailsCache[item.id] = detailsText;
        } catch (_) {
          detailsText = '';
        }
      }
      const detected = mergePremiumMaterials(
        detectPremiumMaterialsFromLinkedData(text),
        extractExplicitMaterialsFromText(detailsText)
      );
      if (key) {
        cache[key] = detected.map(provider => provider.key);
        cacheChanged = true;
      }
      item.materialsHydrated = true;
      const merged = mergePremiumMaterials(item.materials || [], detected);
      if (merged.length !== (item.materials || []).length) {
        item.materials = merged;
        changed = true;
      }
    } catch (_) {
      if (key) {
        cache[key] = (item.materials || []).map(provider => provider.key);
        cacheChanged = true;
      }
      item.materialsHydrated = true;
    }
  }));
  if (cacheChanged) saveMaterialsCache(cache);
  if (changed && token === materialHydrationToken) {
    renderFilters();
    renderCatalog();
  }
}
function scheduleExamTagRefresh(){
  if (examRefreshTimer) clearTimeout(examRefreshTimer);
  const now = new Date();
  const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 5, 0);
  examRefreshTimer = setTimeout(() => {
    renderCatalog();
    scheduleExamTagRefresh();
  }, Math.max(60000, next.getTime() - now.getTime()));
}
function setStatus(message, type = ''){
  const el = document.getElementById('status');
  if (!el) return;
  el.classList.toggle('error', type === 'error');
  el.innerHTML = message || '';
}
function wait(ms){
  return new Promise(resolve => setTimeout(resolve, ms));
}
function installStageInfo(stage, full = false){
  const idle = full ? 'Instalar Edital Premium' : 'Instalar';
  const labels = {
    downloading: { label:'Baixando...', progress:28, className:'stage-running' },
    downloaded: { label:'Download completo', progress:55, className:'stage-running' },
    installing: { label:'Instalando...', progress:78, className:'stage-running' },
    installed: { label:'Instalado', progress:100, className:'stage-installed' },
    failed: { label:'Falhou', progress:100, className:'stage-failed' }
  };
  return labels[stage] || { label:idle, progress:0, className:'' };
}
function setInstallStage(id, stage, message = ''){
  installingId = String(id || '');
  installStage = stage || '';
  renderCatalog();
  if (message) setStatus(message);
}
function renderInstallButton(item, full = false){
  const encoded = encodeURIComponent(item.id);
  const active = installingId === item.id;
  const installed = !active && isItemInstalled(item);
  const locked = Boolean(installingId);
  const info = active ? installStageInfo(installStage, full) : installStageInfo(installed ? 'installed' : '', full);
  const classes = ['btn-primary', 'install-btn'];
  if (active) classes.push('installing');
  if ((active || installed) && info.className) classes.push(info.className);
  const title = installed ? 'Você já possui este edital instalado no perfil atual' : '';
  return `<button class="${classes.join(' ')}" type="button" onclick="event.stopPropagation();installItem(decodeURIComponent('${encoded}'))" ${locked ? 'disabled' : ''} ${title ? `title="${escapeHtml(title)}"` : ''} aria-busy="${active && installStage !== 'installed' ? 'true' : 'false'}" style="--install-progress:${info.progress}%"><span class="install-label">${escapeHtml(info.label)}</span></button>`;
}
function getInstalledPremiumContest(item){
  const list = (CT && typeof CT.getConcursos === 'function') ? CT.getConcursos() : [];
  const catalogId = String(item && item.id || '');
  const fileUrl = cleanInstallUrl(item && item.fileUrl);
  return list.find(c => {
    if (!c) return false;
    const premium = c.premiumCatalog || c.premium || {};
    const savedCatalogId = String(c.premiumCatalogId || c._premiumCatalogId || premium.catalogId || '');
    const savedFileUrl = cleanInstallUrl(c.premiumFileUrl || c._premiumFileUrl || premium.fileUrl || '');
    if (catalogId && savedCatalogId && savedCatalogId === catalogId) return true;
    if (fileUrl && savedFileUrl && savedFileUrl === fileUrl) return true;

    const nameMatch = sameLooseText(c.nome, item.titulo) || sameLooseText(c.nome, item.orgao);
    if (!nameMatch) return false;
    const bancaOk = !item.banca || !c.banca || sameLooseText(c.banca, item.banca);
    const cargoOk = !item.cargo || !c.cargo || sameLooseText(c.cargo, item.cargo);
    return bancaOk && cargoOk;
  }) || null;
}
function isItemInstalled(item){
  return !!getInstalledPremiumContest(item);
}
function openInstalledNotice(item){
  const concurso = getInstalledPremiumContest(item) || {};
  const modal = document.getElementById('installedModal');
  const copy = document.getElementById('installedModalCopy');
  const box = document.getElementById('installedModalBox');
  if (!modal || !copy || !box) return;
  copy.innerHTML = `O botão ficou verde porque este Edital Premium já está instalado no perfil atual. Para evitar duplicidade, o Track não instala uma segunda cópia automaticamente.`;
  const title = concurso.nome || item.titulo || 'Edital Premium';
  const meta = [concurso.banca || item.banca, concurso.cargo || item.cargo].filter(Boolean).join(' | ');
  box.innerHTML = `
    <div class="installed-name">${escapeHtml(title)}</div>
    ${meta ? `<div class="installed-meta">${escapeHtml(meta)}</div>` : ''}
  `;
  modal.classList.add('visible');
  if (!installedModalHistoryActive) {
    try {
      history.pushState({ ...(history.state || {}), installedPremiumModal: true }, '');
      installedModalHistoryActive = true;
    } catch (_) {}
  }
}
function closeInstalledNotice(fromHistory = false){
  const modal = document.getElementById('installedModal');
  if (modal) modal.classList.remove('visible');
  installedModalHistoryActive = false;
  if (!fromHistory) {
    try {
      history.replaceState({ ...(history.state || {}), installedPremiumModal: false }, '');
    } catch (_) {}
  }
}
function openRequestNotice(){
  const modal = document.getElementById('requestModal');
  if (!modal) return;
  modal.classList.add('visible');
  if (!requestModalHistoryActive) {
    try {
      history.pushState({ ...(history.state || {}), requestPremiumModal: true }, '');
      requestModalHistoryActive = true;
    } catch (_) {}
  }
}
function closeRequestNotice(fromHistory = false){
  const modal = document.getElementById('requestModal');
  if (modal) modal.classList.remove('visible');
  requestModalHistoryActive = false;
  if (!fromHistory) {
    try {
      history.replaceState({ ...(history.state || {}), requestPremiumModal: false }, '');
    } catch (_) {}
  }
}
function requestMessage(){
  return 'Olá! Não achei meu concurso na biblioteca de Editais Premium do Track Concursos. Gostaria de solicitar um Edital Premium. Concurso/cargo: ';
}
function openWhatsAppRequest(){
  const url = `https://api.whatsapp.com/send?phone=5589981383459&text=${encodeURIComponent(requestMessage())}`;
  window.open(url, '_blank', 'noopener,noreferrer');
}
function copyRequestEmail(){
  const email = 'michel.araujo.py@gmail.com';
  const notify = () => {
    if (typeof CT !== 'undefined' && CT && typeof CT.toast === 'function') CT.toast('E-mail copiado para a área de transferência.', 'OK');
  };
  if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
    navigator.clipboard.writeText(email).then(notify).catch(() => copyEmailFallback(email, notify));
  } else {
    copyEmailFallback(email, notify);
  }
}
function copyEmailFallback(value, onSuccess){
  const ta = document.createElement('textarea');
  ta.value = value;
  ta.setAttribute('readonly', '');
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try {
    document.execCommand('copy');
    if (typeof onSuccess === 'function') onSuccess();
  } catch (_) {}
  document.body.removeChild(ta);
}
function markPremiumInstalled(item, imported){
  const id = imported && imported.id;
  if (!id || !CT || typeof CT.getConcurso !== 'function' || typeof CT.saveConcurso !== 'function') return;
  const concurso = CT.getConcurso(id);
  if (!concurso) return;
  const premiumCatalog = {
    catalogId: item.id,
    title: item.titulo,
    banca: item.banca || '',
    cargo: item.cargo || '',
    fileUrl: cleanInstallUrl(item.fileUrl),
    imageUrl: cleanInstallUrl(item.imageUrl),
    installedAt: new Date().toISOString()
  };
  CT.saveConcurso({
    ...concurso,
    premiumCatalog,
    premiumCatalogId: premiumCatalog.catalogId,
    premiumFileUrl: premiumCatalog.fileUrl,
    premiumInstalledAt: premiumCatalog.installedAt
  });
}
function applyCatalog(data, source){
  const editais = Array.isArray(data && data.editais) ? data.editais : [];
  const updated = (data && data.atualizadoEm) || '';
  catalogItems = editais.map(item => normalizeItem(item, updated)).filter(item => item.fileUrl);
  catalogMeta = { updated, source };
  if (selectedId && !catalogItems.some(item => item.id === selectedId)) selectedId = '';
  renderFilters();
  renderCatalog();
  hydrateExamDates(catalogItems, ++examHydrationToken);
  hydratePremiumMaterials(catalogItems, ++materialHydrationToken);
}
async function loadCatalog(force = false){
  if (force) {
    detailsCache = {};
    loadingDetailsId = '';
    selectedId = '';
    try { localStorage.removeItem(CACHE_KEY); } catch (_) {}
    try { localStorage.removeItem(MATERIALS_CACHE_KEY); } catch (_) {}
  }
  const cache = readCache();
  if (!force && !catalogItems.length && cache && Array.isArray(cache.editais)) applyCatalog(cache, 'cache');
  setStatus(catalogItems.length ? 'Sincronizando biblioteca premium...' : 'Carregando biblioteca premium...');
  try {
    const res = await fetch(withBust(CATALOG_URL, Date.now()), { cache:'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    saveCache(data);
    applyCatalog(data, 'online');
  } catch (err) {
    if (!catalogItems.length && cache && Array.isArray(cache.editais)) {
      applyCatalog(cache, 'cache');
      setStatus('Não foi possível sincronizar agora. Mostrando o cache local da biblioteca.');
    } else {
      setStatus('Não foi possível carregar a biblioteca premium. Verifique sua conexão e tente atualizar novamente.', 'error');
      document.getElementById('catalogGrid').innerHTML = '<div class="empty">A biblioteca premium não carregou agora. Clique em Atualizar ou tente novamente em instantes.</div>';
    }
  }
}
function renderFilters(){
  const nivelEl = document.getElementById('nivelSelect');
  const bancaEl = document.getElementById('bancaSelect');
  const nivelAtual = nivelEl.value;
  const bancaAtual = bancaEl.value ? premiumBancaKey(bancaEl.value) : '';
  const baseLevels = ['Fundamental', 'Medio', 'Superior', 'Nao informado'];
  const levels = baseLevels.filter(level => catalogItems.some(item => canonicalLevel(item.level) === level));
  const bancaMap = new Map();
  catalogItems.forEach(item => {
    const key = item.bancaKey || premiumBancaKey(item.banca);
    if (!bancaMap.has(key)) bancaMap.set(key, item.banca || 'A definir');
  });
  const bancas = Array.from(bancaMap.entries()).sort((a,b) => a[1].localeCompare(b[1], 'pt-BR'));
  nivelEl.innerHTML = '<option value="">Todos</option>' + levels.map(level => `<option value="${escapeHtml(level)}">${escapeHtml(displayLevel(level))}</option>`).join('');
  bancaEl.innerHTML = '<option value="">Todas</option>' + bancas.map(([key, banca]) => `<option value="${escapeHtml(key)}">${escapeHtml(banca)}</option>`).join('');
  nivelEl.value = nivelAtual && levels.includes(canonicalLevel(nivelAtual)) ? canonicalLevel(nivelAtual) : '';
  bancaEl.value = bancaAtual && bancaMap.has(bancaAtual) ? bancaAtual : '';
}
function filteredItems(){
  const search = normalizeText(document.getElementById('searchInput').value || '');
  const nivel = document.getElementById('nivelSelect').value || '';
  const banca = document.getElementById('bancaSelect').value || '';
  const salaryOrder = document.getElementById('salarySelect').value || '';
  const items = catalogItems.filter(item => {
    if (search && !item.search.includes(search)) return false;
    if (nivel && canonicalLevel(item.level) !== nivel) return false;
    if (banca && (item.bancaKey || premiumBancaKey(item.banca)) !== banca) return false;
    return true;
  });
  if (salaryOrder === 'desc') {
    return items.slice().sort((a,b) => {
      const salaryDiff = Number(b.salaryValue || 0) - Number(a.salaryValue || 0);
      if (salaryDiff) return salaryDiff;
      return String(a.titulo || '').localeCompare(String(b.titulo || ''), 'pt-BR');
    });
  }
  return items;
}
function renderCatalog(){
  const grid = document.getElementById('catalogGrid');
  const items = filteredItems();
  const updated = formatDate(catalogMeta.updated);
  const source = catalogMeta.source === 'cache' ? 'cache local' : 'catálogo online';
  document.getElementById('summaryTotal').textContent = catalogItems.length;
  document.getElementById('summaryFiltered').textContent = items.length;
  setStatus(`<strong>${items.length}</strong> edital${items.length === 1 ? '' : 's'} encontrado${items.length === 1 ? '' : 's'}${updated ? ` · atualizado em ${updated}` : ''} · ${source}`);
  if (!items.length) {
    grid.innerHTML = '<div class="empty">Nenhum edital encontrado com esses filtros. Tente limpar a busca ou escolher outra banca.</div>';
    return;
  }
  if (selectedId && !items.some(item => item.id === selectedId)) selectedId = '';
  grid.innerHTML = items.map(renderCard).join('');
}
function materialHighlightCopy(materials){
  const list = (materials || []).filter(Boolean);
  if (!list.length) return '';
  const qconcursos = list.find(provider => provider.key === 'qconcursos');
  if (qconcursos) return qconcursos.headline;
  if (list.length === 1) return list[0].headline || ('Com ' + list[0].label + ' linkado');
  const labels = list.map(provider => provider.label).filter(Boolean);
  if (labels.length === 2) return 'Com ' + labels[0] + ' e ' + labels[1] + ' linkados';
  return 'Com ' + labels.slice(0, -1).join(', ') + ' e ' + labels[labels.length - 1] + ' linkados';
}
function renderMaterialHighlight(item){
  const materials = item && Array.isArray(item.materials) ? item.materials : [];
  if (!materials.length) return '';
  const logos = materials.filter(provider => provider.logo).slice(0, 3).map(provider => {
    return `<img class="material-highlight-logo" src="${escapeHtml(provider.logo)}" alt="${escapeHtml(provider.label)}" loading="lazy" decoding="async">`;
  }).join('');
  const fallback = logos ? '' : '<span class="material-highlight-logo" style="display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:var(--green);">LINK</span>';
  return `
    <div class="material-highlight" title="${escapeHtml(materials.map(provider => provider.label).join(', '))}">
      <div class="material-highlight-logos">${logos || fallback}</div>
      <div class="material-highlight-text">
        <div class="material-highlight-title">Materiais de estudo linkados</div>
        <div class="material-highlight-sub">${escapeHtml(materialHighlightCopy(materials))}</div>
      </div>
    </div>`;
}
function renderCard(item){
  const encoded = encodeURIComponent(item.id);
  const expanded = selectedId === item.id;
  const tags = buildPremiumTags(item);
  const cardClasses = ['card'];
  if (expanded) cardClasses.push('expanded');
  if (item.materials && item.materials.length) cardClasses.push('has-materials');
  const image = item.imageUrl
    ? `<div class="media"><img src="${escapeHtml(item.imageUrl)}" alt="Capa do edital ${escapeHtml(item.titulo)}" loading="lazy" decoding="async"></div>`
    : '<div class="media placeholder">Imagem do edital não informada</div>';
  return `
    <article class="${cardClasses.join(' ')}" onclick="toggleDetails(decodeURIComponent('${encoded}'))">
      ${image}
      <div class="card-body">
        <div class="card-top"><span>${escapeHtml(item.banca || 'A definir')}</span>${item.ano ? `<span class="card-year">${escapeHtml(item.ano)}</span>` : ''}</div>
        <div class="card-title">${escapeHtml(item.titulo)}</div>
        ${item.cargo ? `<div class="card-cargo">${escapeHtml(item.cargo)}</div>` : ''}
        ${renderMaterialHighlight(item)}
        <div class="tags">${tags.map(tag => `<span class="tag ${String(tag.kind || '').split(/\s+/).filter(Boolean).map(escapeHtml).join(' ')}" ${tag.title ? `title="${escapeHtml(tag.title)}"` : ''}>${escapeHtml(tag.label)}</span>`).join('')}</div>
        <div class="card-actions">
          <button class="btn-outline" type="button" onclick="event.stopPropagation();toggleDetails(decodeURIComponent('${encoded}'))">${expanded ? 'Ocultar' : 'Detalhes'}</button>
          ${renderInstallButton(item)}
        </div>
      </div>
      ${expanded ? renderInlineDetails(item) : ''}
    </article>`;
}
function toggleDetails(id){
  const nextId = String(id || '');
  selectedId = selectedId === nextId ? '' : nextId;
  renderCatalog();
  const item = catalogItems.find(entry => entry.id === selectedId);
  if (item && item.detailsUrls && item.detailsUrls.length && !detailsCache[item.id]) loadDetailsText(item);
}
function renderInlineDetails(item){
  return `
    <div class="card-details" onclick="event.stopPropagation()">
    ${renderDetailsText(item)}
    ${renderInstallButton(item, true)}
    </div>`;
}
function markdownLite(value){
  return escapeHtml(value)
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
}
function renderDetailsText(item){
  const cached = detailsCache[item.id];
  const text = cached || item.detalhesTexto || '';
  if (loadingDetailsId === item.id && !text) {
    return '<div class="details-text"><div class="details-loading">Carregando detalhes do edital...</div></div>';
  }
  if (!text) {
    return `<div class="details-note">${escapeHtml(item.descricao || 'Edital Premium pronto para instalar no Track Concursos.')}</div>`;
  }
  return `<div class="details-text">${markdownLite(text)}</div>`;
}
async function loadDetailsText(item){
  const urls = Array.isArray(item && item.detailsUrls) ? item.detailsUrls : [];
  if (!item || !urls.length || detailsCache[item.id] || loadingDetailsId === item.id) return;
  loadingDetailsId = item.id;
  renderCatalog();
  try {
    const text = await fetchDetailsText(item);
    if (!text) throw new Error('details not found');
    detailsCache[item.id] = text;
    const examDate = extractExamDateFromText(text);
    if (examDate && !item.examDate) item.examDate = examDate;
    const salaryValue = extractSalaryFromText(text);
    if (salaryValue && !item.salaryValue) item.salaryValue = salaryValue;
    const extractedLevel = extractLevelFromText(text);
    const level = extractedLevel ? canonicalLevel(extractedLevel) : '';
    if (level && canonicalLevel(item.level) !== level) {
      item.level = level;
      item.search = normalizeText([item.titulo, item.cargo, item.banca, item.orgao, item.ano, item.level, (item.tags || []).join(' ')].join(' '));
      renderFilters();
    }
    const explicitMaterials = extractExplicitMaterialsFromText(text);
    const mergedMaterials = mergePremiumMaterials(item.materials || [], explicitMaterials);
    if (mergedMaterials.length !== (item.materials || []).length) {
      item.materials = mergedMaterials;
      renderFilters();
    }
  } catch (_) {
    detailsCache[item.id] = item.detalhesTexto || item.descricao || '';
  } finally {
    if (loadingDetailsId === item.id) loadingDetailsId = '';
    if (selectedId === item.id) renderCatalog();
  }
}
async function installItem(id){
  if (installingId) return;
  const item = catalogItems.find(entry => entry.id === String(id || ''));
  if (!item || !item.fileUrl) {
    setStatus('Este edital ainda não possui arquivo JSON vinculado no catálogo.', 'error');
    return;
  }
  if (isItemInstalled(item)) {
    openInstalledNotice(item);
    return;
  }
  let errorMessage = '';
  try {
    setInstallStage(item.id, 'downloading', `Baixando <strong>${escapeHtml(item.titulo)}</strong>...`);
    await wait(180);
    const res = await fetch(withBust(item.fileUrl, Date.now()), { cache:'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const content = await res.text();
    setInstallStage(item.id, 'downloaded', `Download completo de <strong>${escapeHtml(item.titulo)}</strong>.`);
    await wait(320);
    setInstallStage(item.id, 'installing', `Instalando <strong>${escapeHtml(item.titulo)}</strong> no Track...`);
    await wait(180);
    const imported = CT.importarConcurso(content);
    if (!imported || !imported.ok) throw new Error((imported && imported.erro) || 'erro desconhecido');
    markPremiumInstalled(item, imported);
    setInstallStage(item.id, 'installed', `<strong>${escapeHtml(item.titulo)}</strong> instalado.`);
    await wait(620);
    showSuccess(item, imported);
  } catch (err) {
    errorMessage = 'Não foi possível baixar ou instalar esse edital premium. Tente atualizar a biblioteca e repetir.';
    setInstallStage(item.id, 'failed', errorMessage);
    await wait(700);
  } finally {
    installingId = '';
    installStage = '';
    renderCatalog();
    if (errorMessage) setStatus(errorMessage, 'error');
  }
}
function showSuccess(item, imported){
  const bar = document.getElementById('successBar');
  const text = document.getElementById('successText');
  text.textContent = `Edital Premium instalado: ${item.titulo}. Bons estudos!`;
  bar.classList.add('visible');
  if (imported && imported.convertedPastPostEdital) {
    CT.toast('Edital antigo convertido para pré-edital.', 'OK');
  } else {
    CT.toast('Edital Premium instalado com sucesso.', 'OK');
  }
}
function fileSize(bytes){
  const n = Number(bytes || 0);
  if (!n) return '';
  if (n < 1024) return n + ' B';
  if (n < 1024 * 1024) return (n / 1024).toFixed(1).replace('.0','') + ' KB';
  return (n / (1024 * 1024)).toFixed(1).replace('.0','') + ' MB';
}
function setManualError(message){
  const el = document.getElementById('manualError');
  el.textContent = message || '';
  el.style.display = message ? 'block' : 'none';
}
function updateManualState(){
  document.getElementById('manualFileName').textContent = manualName || 'Nenhum arquivo selecionado';
  document.getElementById('manualFileMeta').textContent = manualContent ? `Arquivo carregado${manualSize ? ' · ' + fileSize(manualSize) : ''}` : 'Selecione um arquivo .json';
  document.getElementById('manualImportBtn').disabled = !manualContent;
}
function setManualFileLoaded(content, name, size){
  manualContent = String(content || '');
  manualName = name || 'Edital Premium.json';
  manualSize = size || new Blob([manualContent]).size;
  setManualError('');
  updateManualState();
}
function readManualJsonFile(file){
  if (!file) return;
  if (!/\.json$/i.test(file.name || '')) {
    setManualError('Selecione um arquivo JSON válido.');
    return;
  }
  const reader = new FileReader();
  reader.onload = ev => setManualFileLoaded(ev.target.result || '', file.name, file.size || 0);
  reader.onerror = () => setManualError('Não foi possível ler o arquivo selecionado.');
  reader.readAsText(file);
}
async function openManualFile(){
  setManualError('');
  if (window.pywebview && window.pywebview.api && typeof window.pywebview.api.selecionar_arquivo_json === 'function') {
    const res = await window.pywebview.api.selecionar_arquivo_json();
    if (res && res.ok && res.conteudo) {
      const path = String(res.caminho || '');
      setManualFileLoaded(res.conteudo || '', path ? path.split(/[\\/]/).pop() : 'Edital Premium.json', 0);
    } else if (res && res.motivo && res.motivo !== 'cancelado') {
      setManualError('Não foi possível carregar o arquivo selecionado.');
    }
    return;
  }
  document.getElementById('manualFileInput').click();
}
function importManualFile(){
  if (!manualContent) {
    setManualError('Selecione um arquivo JSON antes de importar.');
    return;
  }
  const btn = document.getElementById('manualImportBtn');
  btn.disabled = true;
  btn.textContent = 'Importando...';
  try {
    const imported = CT.importarConcurso(manualContent);
    if (!imported || !imported.ok) throw new Error((imported && imported.erro) || 'erro desconhecido');
    document.getElementById('successText').textContent = `Arquivo importado: ${manualName || 'Edital Premium.json'}.`;
    document.getElementById('successBar').classList.add('visible');
    CT.toast('Edital Premium importado com sucesso.', 'OK');
    manualContent = '';
    manualName = '';
    manualSize = 0;
    updateManualState();
  } catch (err) {
    setManualError('O arquivo não pode ser importado. Verifique se ele é um JSON válido do Edital Premium.');
  } finally {
    btn.textContent = 'Importar';
    btn.disabled = !manualContent;
  }
}
document.getElementById('searchInput').addEventListener('input', renderCatalog);
document.getElementById('nivelSelect').addEventListener('change', renderCatalog);
document.getElementById('bancaSelect').addEventListener('change', renderCatalog);
document.getElementById('salarySelect').addEventListener('change', renderCatalog);
document.getElementById('installedModal').addEventListener('click', event => {
  if (event.target.id === 'installedModal') closeInstalledNotice();
});
document.getElementById('requestModal').addEventListener('click', event => {
  if (event.target.id === 'requestModal') closeRequestNotice();
});
document.addEventListener('keydown', event => {
  if (event.key !== 'Escape') return;
  if (document.getElementById('installedModal')?.classList.contains('visible')) {
    closeInstalledNotice();
  } else if (document.getElementById('requestModal')?.classList.contains('visible')) {
    closeRequestNotice();
  }
});
window.addEventListener('popstate', () => {
  if (document.getElementById('installedModal')?.classList.contains('visible')) {
    closeInstalledNotice(true);
  } else if (document.getElementById('requestModal')?.classList.contains('visible')) {
    closeRequestNotice(true);
  }
});
document.getElementById('manualFileInput').addEventListener('change', event => {
  const file = event.target.files && event.target.files[0];
  readManualJsonFile(file);
  event.target.value = '';
});
const manualDropZone = document.getElementById('manualDropZone');
if (manualDropZone) {
  let manualDragDepth = 0;
  const hasDraggedFiles = event => Array.from(event.dataTransfer?.types || []).includes('Files');
  const clearManualDrag = () => {
    manualDragDepth = 0;
    manualDropZone.classList.remove('drag-over');
  };
  manualDropZone.addEventListener('dragenter', event => {
    if (!hasDraggedFiles(event)) return;
    event.preventDefault();
    manualDragDepth += 1;
    manualDropZone.classList.add('drag-over');
  });
  manualDropZone.addEventListener('dragover', event => {
    if (!hasDraggedFiles(event)) return;
    event.preventDefault();
    event.dataTransfer.dropEffect = 'copy';
    manualDropZone.classList.add('drag-over');
  });
  manualDropZone.addEventListener('dragleave', event => {
    if (!hasDraggedFiles(event)) return;
    event.preventDefault();
    manualDragDepth = Math.max(0, manualDragDepth - 1);
    if (!manualDragDepth) manualDropZone.classList.remove('drag-over');
  });
  manualDropZone.addEventListener('drop', event => {
    if (!hasDraggedFiles(event)) return;
    event.preventDefault();
    clearManualDrag();
    const file = event.dataTransfer.files && event.dataTransfer.files[0];
    readManualJsonFile(file);
  });
  document.addEventListener('dragover', event => {
    if (hasDraggedFiles(event)) event.preventDefault();
  });
  document.addEventListener('drop', event => {
    if (!hasDraggedFiles(event)) return;
    if (manualDropZone.contains(event.target)) return;
    event.preventDefault();
    clearManualDrag();
  });
}
updateManualState();
scheduleExamTagRefresh();
loadCatalog(false);
