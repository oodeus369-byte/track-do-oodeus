function renderizarGraficoPopupDistribuicao(state) {
  const canvas = document.getElementById('materiaShareChart');
  if (!canvas || !state || !state.items.length) return;
  const theme = themePalette();
  if (_chartPizzaShare) _chartPizzaShare.destroy();
  _chartPizzaShare = new Chart(canvas.getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: state.items.map(item => item.label),
      datasets: [{
        data: state.items.map(item => item.value),
        backgroundColor: state.items.map(item => item.color),
        borderColor: '#0d0f14',
        borderWidth: 3,
        hoverOffset: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '58%',
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: theme.tooltipBg,
          borderColor: theme.tooltipBorder,
          borderWidth: 1,
          titleColor: theme.tooltipTitle,
          bodyColor: theme.tooltipBody,
          callbacks: {
            label: function(ctx) {
              const item = state.items[ctx.dataIndex];
              return ' ' + formatStudyTime(item.seconds) + ' (' + item.pct + '%)';
            }
          }
        }
      }
    }
  });
}

