            <div class="materia-share-belt">
              <img src="${state.faixa.imagem}"${faixaPretaIconClass(state.faixa)} alt="">
              <div class="materia-share-stat-value" style="font-size:15px;color:${state.faixa.cor || '#fff'};line-height:30px">${escapeHtml(state.faixa.nome || 'Faixa Branca')}</div>
            </div>
          </div>
          <div class="today-vertical-metric">
            <div class="materia-share-stat-value">${escapeHtml(state.horas)}</div>
            <div class="materia-share-stat-label">Horas estudadas</div>
          </div>
          <div class="today-vertical-metric">
            <div class="materia-share-stat-value">${state.questoes}</div>
            <div class="materia-share-stat-label">Questões feitas</div>
          </div>
          <div class="today-vertical-metric">
            <div class="materia-share-stat-value">${state.acertosPct != null ? state.acertosPct + '%' : '-'}</div>
            <div class="materia-share-stat-label">Acertos</div>
          </div>
          <div class="today-vertical-metric">
            <div class="materia-share-stat-value">${state.sessoes}</div>
            <div class="materia-share-stat-label">Sessões de estudo</div>
          </div>
        </div>
        <div class="today-vertical-study-block">
          <div class="today-vertical-study-title">Horas por matéria hoje</div>
          ${state.horasItems && state.horasItems.length ? `
            <div class="today-vertical-study-layout">
              <div class="today-vertical-chart"><canvas id="todayVerticalHoursChart"></canvas></div>
              <div class="today-vertical-study-list">${horasRows}</div>
            </div>
          ` : horasRows}
        </div>
      </div>
      <div class="materia-share-actions">
        <button type="button" onclick="fecharPopupEstudosDia()">Fechar</button>
        <button type="button" class="primary" onclick="copiarPrintEstudosDia()">Copiar imagem</button>
      </div>
    </div>
  `;
  overlay.addEventListener('click', function(event) {
    if (event.target === overlay) fecharPopupEstudosDia();
