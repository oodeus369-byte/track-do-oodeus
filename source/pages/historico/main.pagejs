/**
 * Track do Oodeus - [R11-port] script principal de historico.html
 * (original 521-1953 + seams). Script inline CLÁSSICO top-level, SEM IIFE e
 * SEM 'use strict' (como o original); o wrapper do shell
 * (render-util.runPageScripts) faz a ponte de nomes para window — os onclick
 * inline enxergam as funções e as let/const top-level via accessors.
 *
 * Conteúdo (etapa-12): render() (1590-1947) com a SEMÂNTICA ASSIMÉTRICA
 * viva — janela (7/14/30/0) afeta heatmap/análise por matéria/#lblHoras;
 * stats globais e pizza são SEMPRE globais; Estudos do dia é sempre hoje.
 * Heatmap v2 de cards por mês (1430-1588) com 5 níveis por ratio da maior
 * carga (heat1→heat5; limiares 0.9/0.72/0.5/0.28) e legenda SEM heat4
 * (detalhe vivo). Modal único openDayDetail reutilizado p/ dia/mês/ano
 * (showCycleGoal) com painel "Meta do ciclo x tempo estudado" lendo
 * ct_ciclo_<cid>.entries (interoperabilidade obrigatória com o ciclo).
 * Cards PRINT verticais (html2canvas scale 2 → clipboard/download;
 * distribuição por matéria 1304 + estudos do dia 1094). Charts destruídos
 * antes de recriar; pizza GLOBAL cutout 55% em horas float com
 * maintainAspectRatio:true (único); "Estudos do dia" herda cor por NOME da
 * matéria (homônimas colidem — vivo). Dias com estudo × diasComAtividade
 * (o segundo calculado e nunca exibido — replicado como está).
 *
 * Dead codes D1-D8 verbatim (shareTodaySummary órfã com o único toast
 * "@TrackConcursos" e extend 9500ms, D1; PIZZA_COLORS sem uso, D2; labels
 * dd/mm calculada e nunca usada, D3). Acentos ausentes: normalização
 * silenciosa é decisão do doc-mestre §1.5 — AQUI OS TEXTOS FICAM COMO NO
 * ORIGINAL ("No periodo", "sem acertos registrados", "x" minúsculo) até a
 * passada de aceite aplicar a política.
 *
 * Seams [R11-port]: goPage local (precedente revisões/aba-materia); redirect
 * sem cId (522 — sem return: o location.href do original não interrompe a
 * execução). Sem location.search/hash neste script (o foco é o ?revisaoId
 * da revisões, não daqui).
 *
 * Ordem de carregamento do original: Chart.js CDN (9) → html2canvas CDN
 * (10) → style/theme.css (11-334) → body (337-463) → data.js (465) → IIFE
 * sidebar (467-518) → este script (520-1954) → nav.js (1958) →
 * timer-popup.js (1959). No plugin: theme.js/data.js no onload; nav boot
 * ANTES da cadeia (desvio R3); cadeia = [chart.umd (vendored R9),
 * html2canvas (vendored R11 — pendência do R9 fechada: o original só usa
 * html2canvas nos cards PRINT), IIFE sidebar, este script, timer-popup
 * (por último, como o <script src> 1959)].
 */
const cId = sessionStorage.getItem('ct_concurso_ativo');
// [R11-port] Navegação entre páginas (mesmo contrato do goPage do nav.js).
function goPage(dest) {
  if (window.__CT_NAV_GO_PAGE) { window.__CT_NAV_GO_PAGE(dest); return; }
  window.location.href = dest;
}
// Seam do redirect (orig 522): o location.href do original NÃO interrompe a
// execução do script (a navegação só é commitada depois) — sem return, o
// boot segue até render() como no original.
if (!cId) goPage('concursos.html');

let _janela = 0;
let _chartHoras = null, _chartQuestoes = null, _chartPizza = null, _chartPizzaShare = null, _chartTodayHours = null, _chartTodayQuestions = null, _chartTodayVerticalHours = null;
let _chartDayHours = null, _chartDayQuestions = null;
let _pizzaShareState = null;
let _todayShareState = null;

const PIZZA_COLORS = [
  '#4f8ef7','#7c5cfc','#3ecf8e','#f5874a','#f55a5a',
  '#FFD700','#e056a0','#56c4e0','#a78bfa','#f97316',
  '#06b6d4','#8b5cf6','#ec4899','#14b8a6','#f43f5e',
  '#6366f1','#22c55e','#eab308','#ef4444','#0ea5e9'
];

function themePalette() {
  return window.TrackTheme ? TrackTheme.palette() : {
    accent: '#4f8ef7',
    accent2: '#7c5cfc',
    green: '#3ecf8e',
    yellow: '#FFD700',
    orange: '#f5874a',
    red: '#f55a5a',
    text: '#e8eaf2',
    text3: '#a1a6c2',
    chartGrid: 'rgba(255,255,255,0.04)',
    chartAxis: '#555a72',
    chartAxisStrong: '#c8cde2',
    tooltipBg: '#1a1e2a',
    tooltipBorder: 'rgba(255,255,255,0.08)',
    tooltipTitle: '#e8eaf2',
    tooltipBody: '#a1a6c2',
    chartSurfaceBorder: '#0d0f14',
    heatOut: 'rgba(255,255,255,0.02)',
    heatEmpty: 'rgba(255,255,255,0.035)',
    heat1: '#17382b',
    heat2: '#1f5f46',
    heat3: '#268b61',
    heat4: '#2fbd7b',
    heat5: '#3ecf8e'
  };
}

function getPizzaColors() {
  const theme = themePalette();
  return [
    theme.accent, theme.accent2, theme.green, theme.orange, theme.red,
    theme.yellow, '#e056a0', '#56c4e0', '#a78bfa', '#f97316',
    '#06b6d4', '#8b5cf6', '#ec4899', '#14b8a6', '#f43f5e',
    '#6366f1', '#22c55e', '#eab308', '#ef4444', '#0ea5e9'
  ];
}
function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[ch]));
}
function buildLegendRows(items, formatter, emptyText) {
  if (!items.length) return `<div style="color:var(--text3);font-size:12px;text-align:center;padding:16px 0">${emptyText}</div>`;
  return items.map(item => `
    <div style="display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid var(--border)">
      <div style="width:10px;height:10px;border-radius:3px;flex-shrink:0;background:${item.color}"></div>
      <div style="flex:1;min-width:0">
        <div style="font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${item.label}</div>
      </div>
      <div style="font-family:var(--mono);font-size:11px;color:var(--text2);flex-shrink:0">${formatter(item)}</div>
      <div style="font-family:var(--mono);font-size:11px;font-weight:700;color:${item.color};flex-shrink:0;width:38px;text-align:right">${item.pct}%</div>
    </div>
  `).join('');
}
function makeDoughnutChart(target, currentChart, items, theme, tooltipFormatter) {
  const ctx = document.getElementById(target).getContext('2d');
  if (currentChart) currentChart.destroy();
  if (!items.length) {
    ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
    return null;
  }
  return new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: items.map(item => item.label),
      datasets: [{
        data: items.map(item => item.value),
        backgroundColor: items.map(item => item.color),
        borderColor: theme.chartSurfaceBorder,
        borderWidth: 2,
        hoverOffset: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '55%',
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: theme.tooltipBg,
          borderColor: theme.tooltipBorder,
          borderWidth: 1,
          titleColor: theme.tooltipTitle,
          bodyColor: theme.tooltipBody,
          padding: 10,
          cornerRadius: 8,
          callbacks: {
            label: function(ctx) {
              return tooltipFormatter(items[ctx.dataIndex]);
            }
          }
        }
      }
    }
  });
}
function formatSignedStudyTime(seconds) {
  const abs = Math.abs(Math.round(seconds || 0));
  return (seconds >= 0 ? '+' : '-') + formatStudyTime(abs);
}
function daysBetweenInclusive(startKey, endKey) {
  const start = new Date(startKey + 'T00:00:00');
  const end = new Date(endKey + 'T00:00:00');
  return Math.max(1, Math.round((end - start) / 86400000) + 1);
}
function readCycleGoalComparison(info) {
  let raw = null;
  try { raw = JSON.parse(localStorage.getItem('ct_ciclo_' + (cId || '')) || '{}'); } catch (e) { raw = null; }
  const entries = raw && Array.isArray(raw.entries) ? raw.entries : [];
  const activeEntries = entries.filter(entry => (parseInt(entry.targetSeconds, 10) || 0) > 0);
  const weeklyTarget = activeEntries.reduce((acc, entry) => acc + (parseInt(entry.targetSeconds, 10) || 0), 0);
  if (!weeklyTarget) return null;

  const periodDays = daysBetweenInclusive(info.startKey, info.endKey);
  const weekFactor = periodDays / 7;
  const expectedTotal = Math.round(weeklyTarget * weekFactor);
  const studiedTotal = info.totalSeg || 0;
  const balance = studiedTotal - expectedTotal;
  const byMateria = new Map(info.materiasDia.map(m => [m.id, m]));
  const targetByMateria = new Map();
  activeEntries.forEach(entry => {
    if (!entry.materiaId) return;
    targetByMateria.set(entry.materiaId, (targetByMateria.get(entry.materiaId) || 0) + Math.round((parseInt(entry.targetSeconds, 10) || 0) * weekFactor));
  });
  const materias = CT.getMaterias(cId);
  const materiaMap = new Map(materias.map(m => [m.id, m]));
  const rows = [...new Set([...targetByMateria.keys(), ...byMateria.keys()])].map(id => {
    const target = targetByMateria.get(id) || 0;
    const studied = byMateria.get(id)?.seg || 0;
    return {
      id,
      nome: materiaMap.get(id)?.nome || byMateria.get(id)?.nome || 'Matéria',
      target,
      studied,
      balance: studied - target
    };
  }).filter(row => row.target > 0 || row.studied > 0)
    .sort((a,b) => Math.abs(b.balance) - Math.abs(a.balance));
  return { weeklyTarget, periodDays, weekFactor, expectedTotal, studiedTotal, balance, rows };
}
function buildChartLegend(items, formatter, emptyText) {
  if (!items.length) return `<div class="day-detail-empty">${emptyText}</div>`;
  return items.map(item => `
    <div class="day-detail-legend-row">
      <div class="day-detail-legend-dot" style="background:${item.color}"></div>
      <div class="day-detail-legend-name">${escapeHtml(item.label)}</div>
      <div class="day-detail-legend-meta">${formatter(item)}</div>
    </div>
  `).join('');
}
function buildCycleGoalPanel(info) {
  const comparison = readCycleGoalComparison(info);
  if (!comparison) return '';
  const reached = comparison.balance >= 0;
  const pct = comparison.expectedTotal > 0 ? Math.round((comparison.studiedTotal / comparison.expectedTotal) * 100) : 0;
  const badgeColor = reached ? 'var(--green)' : 'var(--yellow)';
  const message = reached
    ? 'Meta batida. Excelente consistência: você entregou a carga prevista para este período.'
    : 'Você estudou, e isso conta. Abaixo dá para ver onde faltou carga em relação ao ciclo planejado.';
  const rows = comparison.rows.length ? comparison.rows.map(row => {
    const color = row.balance >= 0 ? 'var(--green)' : 'var(--yellow)';
    return `
      <div class="cycle-goal-row">
        <div class="cycle-goal-name">${escapeHtml(row.nome)}</div>
        <div style="font-family:var(--mono);font-size:12px;font-weight:900;color:var(--text2);text-align:right">${formatStudyTime(row.studied)}</div>
        <div style="font-family:var(--mono);font-size:12px;font-weight:900;color:var(--text3);text-align:right">${formatStudyTime(row.target)}</div>
        <div style="font-family:var(--mono);font-size:12px;font-weight:900;color:${color};text-align:right">${formatSignedStudyTime(row.balance)}</div>
      </div>`;
  }).join('') : '<div class="day-detail-empty">Nenhuma matéria do ciclo apareceu neste período.</div>';

  return `
    <div class="cycle-goal-panel">
      <div class="cycle-goal-head">
        <div>
          <div class="cycle-goal-title">Meta do ciclo x tempo estudado</div>
          <div class="cycle-goal-sub">${message}</div>
        </div>
        <div class="cycle-goal-badge" style="color:${badgeColor}">${pct}% da meta</div>
      </div>
      <div class="cycle-goal-grid">
        <div class="cycle-goal-stat"><div class="cycle-goal-value">${formatStudyTime(comparison.studiedTotal)}</div><div class="cycle-goal-label">Estudado</div></div>
        <div class="cycle-goal-stat"><div class="cycle-goal-value">${formatStudyTime(comparison.expectedTotal)}</div><div class="cycle-goal-label">Previsto pelo ciclo</div></div>
        <div class="cycle-goal-stat"><div class="cycle-goal-value" style="color:${badgeColor}">${formatSignedStudyTime(comparison.balance)}</div><div class="cycle-goal-label">Saldo</div></div>
      </div>
      <div class="cycle-goal-row" style="border-top:0;padding-top:0;color:var(--text3);font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.45px">
        <div>Matéria</div><div style="text-align:right">Estudado</div><div style="text-align:right">Meta</div><div style="text-align:right">Saldo</div>
      </div>
      <div class="cycle-goal-matters">${rows}</div>
    </div>`;
}
function closeDayDetail() {
  document.getElementById('dayDetailOverlay')?.remove();
  if (_chartDayHours) { _chartDayHours.destroy(); _chartDayHours = null; }
  if (_chartDayQuestions) { _chartDayQuestions.destroy(); _chartDayQuestions = null; }
}
function buildDayActivity(startKey, endKey = startKey) {
  const materias = CT.getMaterias(cId);
  const materiaMap = new Map(materias.map(m => [m.id, m]));
  const topicoMap = new Map(CT.getTopicos().map(t => [t.id, t]));
  const subtopicoMap = new Map(CT.getSubtopicos().map(s => [s.id, s]));
  const inRange = item => item.data >= startKey && item.data <= endKey;
  const compareActivity = (a,b) =>
    String(a.data || '').localeCompare(String(b.data || '')) ||
    String(a.horaInicio || '').localeCompare(String(b.horaInicio || ''));
  const sessoes = CT.getSessoes({ concursoId: cId })
    .filter(inRange)
    .sort(compareActivity);
  const questoes = CT.getQuestoes({ concursoId: cId })
    .filter(inRange)
    .sort(compareActivity);
  const totalSeg = CT.totalSegundos(sessoes);
  const stats = CT.calcStats(questoes);
  const metricasTotais = CT.somarMetricasSessoes ? CT.somarMetricasSessoes(sessoes) : { paginasPdf: 0, videoMinutos: 0 };
  const metricasItems = CT.formatarMetricasSessao ? CT.formatarMetricasSessao({ metricas: metricasTotais }) : [];
  const temEstudoRegistrado = s => (s.duracaoSegundos || 0) > 0 || (CT.formatarMetricasSessao && CT.formatarMetricasSessao(s).length > 0);
  const diasComEstudo = new Set(sessoes.filter(temEstudoRegistrado).map(s => s.data)).size;
  const diasComAtividade = new Set([...sessoes.map(s => s.data), ...questoes.map(q => q.data)]).size;
  const colors = getPizzaColors();
  const theme = themePalette();

  const materiasDia = materias.map((m, i) => {
    const sessoesMateria = sessoes.filter(s => s.materiaId === m.id);
    const questoesMateria = questoes.filter(q => q.materiaId === m.id);
    const seg = CT.totalSegundos(sessoesMateria);
    const qStats = CT.calcStats(questoesMateria);
    const metricas = CT.somarMetricasSessoes ? CT.somarMetricasSessoes(sessoesMateria) : { paginasPdf: 0, videoMinutos: 0 };
    const metricasResumo = CT.formatarResumoMetricasSessao ? CT.formatarResumoMetricasSessao({ metricas }) : '';
    return {
      id: m.id,
      nome: m.nome,
      seg,
      metricas,
      metricasResumo,
      sessoes: sessoesMateria.length,
      resolvidas: qStats.resolvidas || 0,
      acertos: qStats.acertos || 0,
      erros: qStats.erros || 0,
      pct: qStats.pct,
      color: colors[i % colors.length]
    };
  }).filter(m => m.seg > 0 || m.resolvidas > 0 || m.metricasResumo);

  const maxSeg = Math.max(...materiasDia.map(m => m.seg), 0);
  const maxQuestoes = Math.max(...materiasDia.map(m => m.resolvidas), 0);
  const horasItems = materiasDia
    .filter(m => m.seg > 0)
    .map(m => ({
      label: m.nome,
      value: m.seg,
      color: m.color,
      pct: totalSeg > 0 ? Math.round((m.seg / totalSeg) * 100) : 0
    }));
  const questoesItems = [
    { label: 'Certas', value: stats.acertos || 0, color: theme.green, pct: stats.resolvidas > 0 ? Math.round(((stats.acertos || 0) / stats.resolvidas) * 100) : 0 },
    { label: 'Erradas', value: stats.erros || 0, color: theme.red, pct: stats.resolvidas > 0 ? Math.round(((stats.erros || 0) / stats.resolvidas) * 100) : 0 }
  ].filter(item => item.value > 0);

  function itemLabel(item) {
    const mat = item.materiaId ? materiaMap.get(item.materiaId) : null;
    const topico = item.topicoId ? topicoMap.get(item.topicoId) : null;
    const subtopicoId = item.subtopId || item.subtopicoId;
    const sub = subtopicoId ? subtopicoMap.get(subtopicoId) : null;
    return {
      materia: mat ? mat.nome : 'Sessão livre',
      detalhe: [topico?.nome, sub?.nome].filter(Boolean).join(' > ')
    };
  }

  return { startKey, endKey, sessoes, questoes, totalSeg, stats, metricasTotais, metricasItems, diasComEstudo, diasComAtividade, materiasDia, maxSeg, maxQuestoes, horasItems, questoesItems, itemLabel, theme };
}
function openDayDetail(dateKey, options = {}) {
  closeDayDetail();
  const startKey = options.startKey || dateKey;
  const endKey = options.endKey || dateKey;
  const info = buildDayActivity(startKey, endKey);
  const titleText = options.title || `Atividades de ${formatHeatmapDate(dateKey)}`;
  const scopeText = options.scopeText || 'neste dia';
  const emptyLabel = options.emptyLabel || 'nesse dia';
  const periodLabel = options.periodLabel || 'no dia';
  const questionsTitle = options.questionsTitle || 'Questões do dia';
  const showCycleGoal = options.showCycleGoal === true;
  const totalAtividades = info.sessoes.length + info.questoes.length;
  const overlay = document.createElement('div');
  overlay.className = 'day-detail-overlay';
  overlay.id = 'dayDetailOverlay';
  overlay.onclick = e => { if (e.target === overlay) closeDayDetail(); };

  const materiaRows = info.materiasDia.length ? info.materiasDia.map(m => {
    const horaPct = info.maxSeg > 0 ? Math.max(4, Math.round((m.seg / info.maxSeg) * 100)) : 0;
    const questPct = info.maxQuestoes > 0 ? Math.max(4, Math.round((m.resolvidas / info.maxQuestoes) * 100)) : 0;
    return `
      <div class="day-detail-materia-row">
        <div style="min-width:0">
          <div class="day-detail-materia-name">${escapeHtml(m.nome)}</div>
          <div class="day-detail-materia-meta">${[`${m.sessoes} sessões de estudo`, `${m.acertos} acertos`, `${m.resolvidas} questões`, m.pct != null ? m.pct + '% de acerto' : 'sem questões', m.metricasResumo].filter(Boolean).map(escapeHtml).join(' | ')}</div>
          <div class="day-detail-bar-label"><span>Tempo estudado</span><span>${formatStudyTime(m.seg)}</span></div>
          <div class="day-detail-bar"><div class="day-detail-bar-fill" style="width:${horaPct}%;background:${m.color}"></div></div>
          ${m.resolvidas > 0 ? `<div class="day-detail-bar-label"><span>Questões feitas</span><span>${m.resolvidas}</span></div>` : ''}
          ${m.resolvidas > 0 ? `<div class="day-detail-bar"><div class="day-detail-bar-fill" style="width:${questPct}%;background:${info.theme.yellow}"></div></div>` : ''}
        </div>
        <div style="font-family:var(--mono);font-size:12px;font-weight:800;color:var(--text2);text-align:right">${formatStudyTime(m.seg)}</div>
        <div style="font-family:var(--mono);font-size:12px;font-weight:800;color:${pctColor(m.pct)};text-align:right">${m.pct != null ? m.pct + '%' : '-'}</div>
      </div>`;
  }).join('') : `<div class="day-detail-empty">Nenhuma matéria estudada ${emptyLabel}.</div>`;

  const sessaoRows = info.sessoes.length ? info.sessoes.map(s => {
    const labels = info.itemLabel(s);
    const hora = s.horaInicio ? new Date(s.horaInicio).toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' }) : '--:--';
    const tipo = formatStudyTypeLabel(s);
    const metricas = CT.formatarResumoMetricasSessao ? CT.formatarResumoMetricasSessao(s) : '';
    return `
      <div class="today-session-item">
        <div class="today-session-hour">${hora}</div>
        <div style="min-width:0">
          <div class="today-session-name">${escapeHtml(labels.materia)}</div>
          <div class="today-session-meta">${escapeHtml([labels.detalhe, tipo, metricas].filter(Boolean).join(' | '))}</div>
        </div>
        <div class="today-session-duration">${formatStudyTime(s.duracaoSegundos)}</div>
      </div>`;
  }).join('') : `<div class="day-detail-empty">Nenhuma sessão de estudo registrada ${emptyLabel}.</div>`;

  const questaoRows = info.questoes.length ? info.questoes.map(q => {
    const labels = info.itemLabel(q);
    const hora = q.horaInicio ? new Date(q.horaInicio).toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' }) : '--:--';
    const pct = q.resolvidas > 0 ? Math.round(((q.acertos || 0) / q.resolvidas) * 100) : null;
    const pctText = pct != null ? pct + '%' : '-';
    return `
      <div class="today-session-item">
        <div class="today-session-hour">${hora}</div>
        <div style="min-width:0">
          <div class="today-session-name">${escapeHtml(labels.materia)}</div>
          <div class="today-session-meta">${escapeHtml(labels.detalhe || 'Lançamento de questões')}</div>
        </div>
        <div class="question-result">
          <span style="color:var(--green)">${q.acertos || 0}<small>acertos</small></span>
          <span>${q.resolvidas || 0}<small>questões</small></span>
          <span style="color:${pctColor(pct)}">${pctText}<small>acerto</small></span>
        </div>
      </div>`;
  }).join('') : `<div class="day-detail-empty">Nenhuma questão registrada ${emptyLabel}.</div>`;
  const cycleGoalPanel = showCycleGoal ? buildCycleGoalPanel(info) : '';
  const metricasExtrasPanel = info.metricasItems && info.metricasItems.length ? `
      <div class="day-detail-stats" style="margin-top:-4px">
        ${info.metricasItems.map(item => {
          const parts = String(item.label || '').split(' ');
          const value = parts.shift() || '';
          const label = parts.join(' ');
          return `<div class="day-detail-stat"><div class="day-detail-stat-value">${escapeHtml(value)}</div><div class="day-detail-stat-label">${escapeHtml(label)}</div></div>`;
        }).join('')}
      </div>` : '';

  overlay.innerHTML = `
    <div class="day-detail-modal" onclick="event.stopPropagation()">
      <div class="day-detail-head">
        <div>
          <div class="day-detail-title">${titleText}</div>
          <div class="day-detail-sub">${totalAtividades ? totalAtividades + ' registros encontrados ' + scopeText : 'Nenhuma atividade registrada ' + scopeText}</div>
        </div>
        <button class="day-detail-close" onclick="closeDayDetail()" title="Fechar">x</button>
      </div>
      <div class="day-detail-stats">
        <div class="day-detail-stat"><div class="day-detail-stat-value">${formatStudyTime(info.totalSeg)}</div><div class="day-detail-stat-label">Horas estudadas</div></div>
        <div class="day-detail-stat"><div class="day-detail-stat-value">${info.stats.resolvidas || 0}</div><div class="day-detail-stat-label">Questões feitas</div></div>
        <div class="day-detail-stat"><div class="day-detail-stat-value" style="color:${pctColor(info.stats.pct)}">${info.stats.pct != null ? info.stats.pct + '%' : '-'}</div><div class="day-detail-stat-label">Taxa de acerto</div></div>
        <div class="day-detail-stat"><div class="day-detail-stat-value">${info.materiasDia.length}</div><div class="day-detail-stat-label">Matérias movimentadas</div></div>
        <div class="day-detail-stat"><div class="day-detail-stat-value">${info.diasComEstudo || 0}</div><div class="day-detail-stat-label">Dias com estudo</div></div>
      </div>
      ${metricasExtrasPanel}
      <div class="day-detail-grid">
        <div class="day-detail-panel">
          <div class="day-detail-panel-title">Horas por matéria</div>
          <div class="day-detail-panel-sub">${info.totalSeg > 0 ? formatStudyTime(info.totalSeg) + ' distribuídos ' + periodLabel : 'Sem horas ' + periodLabel}</div>
          <div class="day-detail-chart-layout">
            <div class="day-detail-chart"><canvas id="chartDayHours"></canvas></div>
            <div class="day-detail-chart-legend">${buildChartLegend(info.horasItems, item => `${formatStudyTime(item.value)} | ${item.pct}%`, 'Sem horas para mostrar.')}</div>
          </div>
        </div>
        <div class="day-detail-panel">
          <div class="day-detail-panel-title">${questionsTitle}</div>
          <div class="day-detail-panel-sub">${info.stats.resolvidas ? (info.stats.acertos || 0) + ' acertos e ' + (info.stats.erros || 0) + ' erros' : 'Sem questões ' + periodLabel}</div>
          <div class="day-detail-chart-layout">
            <div class="day-detail-chart"><canvas id="chartDayQuestions"></canvas></div>
            <div class="day-detail-chart-legend">
              ${buildChartLegend(info.questoesItems, item => `${item.value} | ${item.pct}%`, 'Sem questões para mostrar.')}
              ${info.stats.resolvidas ? `<div class="day-detail-legend-row" style="border-top:1px solid var(--border);padding-top:8px"><div></div><div class="day-detail-legend-name">Taxa de acerto</div><div class="day-detail-legend-meta" style="color:${pctColor(info.stats.pct)}">${info.stats.pct}%</div></div>` : ''}
            </div>
          </div>
        </div>
      </div>
      ${cycleGoalPanel}
      <div class="day-detail-grid">
        <div class="day-detail-panel">
          <div class="day-detail-panel-title">Resumo por matéria</div>
          <div class="day-detail-list">${materiaRows}</div>
        </div>
        <div class="day-detail-panel">
          <div class="day-detail-panel-title">Sessões de estudo</div>
          <div class="day-detail-list">${sessaoRows}</div>
        </div>
      </div>
      <div class="day-detail-panel">
        <div class="day-detail-panel-title">Lançamentos de questões</div>
        <div class="day-detail-list">${questaoRows}</div>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  _chartDayHours = makeDoughnutChart(
    'chartDayHours',
    _chartDayHours,
    info.horasItems,
    info.theme,
    item => `${item.label}: ${formatStudyTime(item.value)} (${item.pct}%)`
  );
  _chartDayQuestions = makeDoughnutChart(
    'chartDayQuestions',
    _chartDayQuestions,
    info.questoesItems,
    info.theme,
    item => `${item.label}: ${item.value} (${item.pct}%)`
  );
}
function openMonthDetail(year, monthIndex) {
  const monthNames = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
  const start = `${year}-${String(monthIndex + 1).padStart(2, '0')}-01`;
  const end = CT._dateString(new Date(year, monthIndex + 1, 0));
  openDayDetail(start, {
    startKey: start,
    endKey: end,
    title: `Estatísticas de ${monthNames[monthIndex]} de ${year}`,
    scopeText: 'neste mês',
    emptyLabel: 'nesse mês',
    periodLabel: 'no mês',
    questionsTitle: 'Questões do mês',
    showCycleGoal: true
  });
}
function openYearDetail(year) {
  openDayDetail(`${year}-01-01`, {
    startKey: `${year}-01-01`,
    endKey: `${year}-12-31`,
    title: `Retrospectiva de estudos de ${year}`,
    scopeText: 'neste ano',
    emptyLabel: 'nesse ano',
    periodLabel: 'no ano',
    questionsTitle: 'Questões do ano',
    showCycleGoal: true
  });
}
function openSelectedYearDetail() {
  const select = document.getElementById('annualAnalysisYear');
  const year = select ? parseInt(select.value, 10) : null;
  if (year) openYearDetail(year);
}
async function shareTodaySummary() {
  const card = document.getElementById('todayShareCard');
  if (!card || typeof html2canvas === 'undefined') return;
  card.classList.add('capture-mode', 'today-capture-flash');
  await new Promise(resolve => setTimeout(resolve, 120));
  try {
    const canvas = await html2canvas(card, {
      backgroundColor: null,
      scale: 2,
      useCORS: true,
      logging: false
    });
    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
    if (!blob) throw new Error('Falha ao gerar imagem');
    if (navigator.clipboard && window.ClipboardItem) {
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
      CT.toast('O de hoje tá pago 💪 Print pronto para colar com Ctrl + V! Poste no Twitter e marque o Track Concursos! @TrackConcursos', '📸');
      const toastEl = document.getElementById('ct-main-toast');
      if (toastEl) {
        if (toastEl.hideTimeout) clearTimeout(toastEl.hideTimeout);
        toastEl.hideTimeout = setTimeout(() => {
          toastEl.style.transform = 'translateX(150%)';
        }, 9500);
      }
    } else {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'track-concursos-estudos-de-hoje.png';
      link.click();
      URL.revokeObjectURL(url);
      CT.toast('Clipboard não suportado aqui. O print foi baixado.', '📸');
    }
  } catch (err) {
    console.error(err);
    CT.toast('Não foi possível gerar o print agora.', '❌');
  } finally {
    card.classList.remove('capture-mode');
    setTimeout(() => card.classList.remove('today-capture-flash'), 380);
  }
}

function prepararEstadoEstudosDia(c, hojeKey, totalSegHoje, statsHoje, sessoesHoje, horasItems = []) {
  const faixa = getFaixaAtualMetricas(c.id);
  return {
    concurso: c.nome || 'Meu concurso',
    detalhes: [c.banca, c.cargo].filter(Boolean).join(' | '),
    dataLabel: hojeKey ? hojeKey.split('-').reverse().join('/') : '',
    horas: formatStudyTime(totalSegHoje || 0),
    questoes: statsHoje.resolvidas || 0,
    acertosPct: statsHoje.pct,
    sessoes: sessoesHoje.length || 0,
    horasItems: horasItems.map(item => ({
      label: item.label,
      seconds: item.value,
      value: Number((item.value / 3600).toFixed(2)),
      pct: item.pct,
      color: item.color
    })),
    faixa
  };
}

function fecharPopupEstudosDia() {
  document.getElementById('todayVerticalOverlay')?.remove();
  if (_chartTodayVerticalHours) {
    _chartTodayVerticalHours.destroy();
    _chartTodayVerticalHours = null;
  }
}

function renderizarGraficoPopupEstudosDia(state) {
  const canvas = document.getElementById('todayVerticalHoursChart');
  if (!canvas || !state || !state.horasItems || !state.horasItems.length) return;
  if (_chartTodayVerticalHours) _chartTodayVerticalHours.destroy();
  _chartTodayVerticalHours = new Chart(canvas.getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: state.horasItems.map(item => item.label),
      datasets: [{
        data: state.horasItems.map(item => item.value),
        backgroundColor: state.horasItems.map(item => item.color),
        borderColor: '#0d0f14',
        borderWidth: 3,
        hoverOffset: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '58%',
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      animation: { duration: 0 }
    }
  });
}

