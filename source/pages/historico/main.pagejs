function getFaixaAtualMetricas(concursoId) {
  try {
    const stats = CT.calcStats(CT.getQuestoes({ concursoId }));
    if (CT._cardExportFaixa) return CT._cardExportFaixa(concursoId, stats);
  } catch (e) {}
  return { nome: 'Faixa Branca', imagem: __ctAssetUrl('assets/faixas/faixabranca.png'), cor: '#e8eaf2' };
}

function faixaPretaIconClass(faixa) {
  return faixa && faixa.nome === 'Faixa Preta' ? ' class="faixa-preta-icon"' : '';
}

function prepararEstadoCompartilhamentoPizza(c, ranking, totalSeg, paletteColors) {
  const positivos = ranking.filter(item => item.seg > 0);
  const maxRows = 8;
  const principais = positivos.slice(0, maxRows);
  const restantes = positivos.slice(maxRows);
  const items = principais.map((item, index) => ({
    label: item.nome,
    seconds: item.seg,
    value: item.seg,
    questoes: item.q && item.q.resolvidas ? item.q.resolvidas : 0,
    acertosPct: item.q && item.q.pct != null ? item.q.pct : null,
    color: paletteColors[index % paletteColors.length],
    pct: totalSeg > 0 ? Math.round((item.seg / totalSeg) * 100) : 0
  }));
  if (restantes.length) {
    const restSeg = restantes.reduce((acc, item) => acc + item.seg, 0);
    const restQuestoes = restantes.reduce((acc, item) => acc + ((item.q && item.q.resolvidas) || 0), 0);
    const restAcertos = restantes.reduce((acc, item) => acc + ((item.q && item.q.acertos) || 0), 0);
    items.push({
      label: 'Outras matérias',
      seconds: restSeg,
      value: restSeg,
      questoes: restQuestoes,
      acertosPct: restQuestoes > 0 ? Math.round((restAcertos / restQuestoes) * 100) : null,
      color: '#94a3b8',
      pct: totalSeg > 0 ? Math.round((restSeg / totalSeg) * 100) : 0
    });
  }
  const faixa = getFaixaAtualMetricas(c.id);
  const cobertura = (c.coberto || 0) + (c.cobertoPre || 0);
  const detalhes = [c.banca, c.cargo].filter(Boolean).join(' | ');
  const questoesStatsTotal = CT.calcStats(CT.getQuestoes({ concursoId: c.id }));
  return {
    concurso: c.nome || 'Meu concurso',
    detalhes,
    totalSeg,
    totalLabel: totalSeg > 0 ? CT.formatarTempo(totalSeg) : '0min',
    questoesTotal: questoesStatsTotal.resolvidas || 0,
    acertosPctTotal: questoesStatsTotal.pct,
    cobertura,
    faixa,
    items
  };
}

function fecharPopupDistribuicaoMateria() {
