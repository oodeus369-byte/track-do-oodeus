        </div>
        <div class="materia-share-title">${escapeHtml(state.concurso)}</div>
        <div class="materia-share-sub">${state.dataLabel ? 'Hoje | ' + escapeHtml(state.dataLabel) : 'Hoje'}${state.detalhes ? ' | ' + escapeHtml(state.detalhes) : ''}</div>
        <div class="today-vertical-metrics">
