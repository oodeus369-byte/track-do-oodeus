    `).join('')
    : '<div class="materia-share-empty" style="padding:18px 12px">Nenhuma sessão registrada hoje.</div>';
  const overlay = document.createElement('div');
  overlay.id = 'todayVerticalOverlay';
  overlay.className = 'materia-share-overlay';
  overlay.innerHTML = `
    <div class="materia-share-modal">
      <div class="materia-share-card today-vertical-card" id="todayVerticalCapture">
        <div class="materia-share-brand">
          <img src="${__ctAssetUrl('assets/Track Concursos logo.png')}" alt="Track Concursos">
