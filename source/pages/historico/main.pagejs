        <div class="materia-share-stats">
          <div class="materia-share-stat">
            <div class="materia-share-stat-value">${escapeHtml(state.totalLabel)}</div>
            <div class="materia-share-stat-label">Horas estudadas</div>
          </div>
          <div class="materia-share-stat">
            <div class="materia-share-stat-value">x${state.cobertura || 0}</div>
            <div class="materia-share-stat-label">Edital coberto</div>
          </div>
          <div class="materia-share-stat">
            <div class="materia-share-belt">
              <img src="${state.faixa.imagem}"${faixaPretaIconClass(state.faixa)} alt="">
              <div>
                <div class="materia-share-stat-value" style="font-size:14px;color:${state.faixa.cor || '#fff'};line-height:30px">${escapeHtml(state.faixa.nome || 'Faixa Branca')}</div>
              </div>
            </div>
          </div>
          <div class="materia-share-stat">
            <div class="materia-share-stat-value">${state.questoesTotal || 0}</div>
            <div class="materia-share-stat-label">${state.acertosPctTotal != null ? state.acertosPctTotal + '% acertos' : 'Acertos'}</div>
          </div>
        </div>
        <div class="materia-share-chart">
          ${state.items.length ? '<canvas id="materiaShareChart"></canvas>' : '<div class="materia-share-empty">Sem dados para gerar gráfico.</div>'}
        </div>
        <div class="materia-share-list">${rows}</div>
      </div>
      <div class="materia-share-actions">
        <button type="button" onclick="fecharPopupDistribuicaoMateria()">Fechar</button>
        <button type="button" class="primary" onclick="copiarPrintDistribuicaoMateria()">Copiar imagem</button>
      </div>
    </div>
  `;
  overlay.addEventListener('click', function(event) {
    if (event.target === overlay) fecharPopupDistribuicaoMateria();
  });
  document.body.appendChild(overlay);
  setTimeout(function() { renderizarGraficoPopupDistribuicao(state); }, 30);
}

