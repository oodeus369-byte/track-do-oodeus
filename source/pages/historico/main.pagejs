function setJanela(dias, el) {
  _janela = dias;
  document.querySelectorAll('.filtro-chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  render();
}

function pctColor(p){return CT.pctColor?CT.pctColor(p):'var(--text3)';}
function formatStudyTime(segundos) {
  return CT.formatarTempo(Math.max(0, Math.round(segundos || 0))) || '0min';
}
function formatHoursAsStudyTime(horas) {
  return formatStudyTime((horas || 0) * 3600);
}
function formatStudyTypeLabel(sessao) {
  if (sessao && sessao.tipoEstudo) return String(sessao.tipoEstudo);
  if (!sessao || !sessao.origem) return '';
  if (sessao.origem === 'pomodoro') return 'Pomodoro';
  if (sessao.origem === 'manual_ciclo') return 'Ciclo de estudos';
  return '';
}

function formatHeatmapDate(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function renderHorasHeatmap(container, datas, horasPorDia) {
  const theme = themePalette();
  const horasMap = new Map(datas.map((d, i) => [d, parseFloat((horasPorDia[i] || 0).toFixed(2))]));
  const maxHoras = Math.max(...horasPorDia, 0);

  if (!datas.length) {
    container.innerHTML = '<div style="padding:20px;border:1px dashed var(--border);border-radius:14px;color:var(--text3);text-align:center">Nenhum estudo registrado no período.</div>';
    return;
  }

  const first = new Date(datas[0] + 'T00:00:00');
  const last = new Date(datas[datas.length - 1] + 'T00:00:00');
  const totalDiasComEstudo = horasPorDia.filter(h => h > 0).length;
  const maiorCarga = Math.max(...horasPorDia, 0);
  const annualYears = [...new Set([
    ...CT.getSessoes({ concursoId: cId }).filter(s => s.data).map(s => String(s.data).slice(0, 4)),
    ...CT.getQuestoes({ concursoId: cId }).filter(q => q.data).map(q => String(q.data).slice(0, 4))
  ])].filter(Boolean).sort((a,b) => Number(b) - Number(a));
  const annualControl = annualYears.length ? `
    <div class="annual-analysis">
      <span class="annual-analysis-label">Análise anual</span>
      <select id="annualAnalysisYear" title="Escolha um ano com estudos registrados">
        ${annualYears.map(year => `<option value="${year}">${year}</option>`).join('')}
      </select>
      <button type="button" onclick="openSelectedYearDetail()">Ver</button>
    </div>
  ` : '';
  const monthLabels = ['JAN', 'FEV', 'MAR', 'ABR', 'MAI', 'JUN', 'JUL', 'AGO', 'SET', 'OUT', 'NOV', 'DEZ'];
  const weekLabels = ['SEG', 'TER', 'QUA', 'QUI', 'SEX', 'SAB', 'DOM'];

  function heatColor(horas, inRange) {
    if (!inRange) return theme.heatOut;
    if (horas <= 0) return theme.heatEmpty;
    const ratio = maxHoras > 0 ? horas / maxHoras : 0;
    if (ratio >= 0.9) return theme.heat5;
    if (ratio >= 0.72) return theme.heat4;
    if (ratio >= 0.5) return theme.heat3;
    if (ratio >= 0.28) return theme.heat2;
    return theme.heat1;
  }

  function heatTextColor(horas, inRange) {
    if (!inRange || horas <= 0) return 'var(--text3)';
    const ratio = maxHoras > 0 ? horas / maxHoras : 0;
    return ratio >= 0.72 ? '#082016' : 'var(--text)';
  }

  const months = [];
  let monthCursor = new Date(first.getFullYear(), first.getMonth(), 1);
  const finalMonth = new Date(last.getFullYear(), last.getMonth(), 1);
  while (monthCursor <= finalMonth) {
    const monthStart = new Date(monthCursor.getFullYear(), monthCursor.getMonth(), 1);
    const monthEnd = new Date(monthCursor.getFullYear(), monthCursor.getMonth() + 1, 0);
    const leading = (monthStart.getDay() + 6) % 7;
    const trailing = 6 - ((monthEnd.getDay() + 6) % 7);
    const gridStart = new Date(monthStart);
    gridStart.setDate(gridStart.getDate() - leading);
    const gridEnd = new Date(monthEnd);
    gridEnd.setDate(gridEnd.getDate() + trailing);

    const cells = [];
    const dayCursor = new Date(gridStart);
    while (dayCursor <= gridEnd) {
      const key = CT._dateString(dayCursor);
      const horas = horasMap.get(key) || 0;
      const inCurrentMonth = dayCursor.getMonth() === monthCursor.getMonth();
      const inRange = key >= datas[0] && key <= datas[datas.length - 1];
      cells.push({
        key,
        horas,
        day: dayCursor.getDate(),
        inCurrentMonth,
        inRange
      });
      dayCursor.setDate(dayCursor.getDate() + 1);
    }

    months.push({
      title: monthLabels[monthCursor.getMonth()],
      year: monthCursor.getFullYear(),
      monthIndex: monthCursor.getMonth(),
      cells
    });
    monthCursor = new Date(monthCursor.getFullYear(), monthCursor.getMonth() + 1, 1);
  }

  container.innerHTML = `
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;align-items:start">
      ${months.map(month => `
        <div class="heatmap-month-card" role="button" tabindex="0" onclick="openMonthDetail(${month.year},${month.monthIndex})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openMonthDetail(${month.year},${month.monthIndex});}" title="Ver retrospectiva de ${month.title}/${month.year}">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
            <div style="font-size:13px;font-weight:800;letter-spacing:1px;color:var(--text)">${month.title}</div>
            <div style="font-size:11px;color:var(--text3)">${month.year}</div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px">
            ${weekLabels.map(label => `
              <div style="font-size:10px;color:var(--text3);text-align:center;font-weight:700;letter-spacing:.4px;padding-bottom:2px">${label}</div>
            `).join('')}
            ${month.cells.map(day => {
              const commonStyle = `
                  width:100%;
                  min-height:30px;
                  border-radius:10px;
                  padding:4px 4px 3px;
                  border:1px solid ${day.horas > 0 && day.inCurrentMonth && day.inRange ? (window.TrackTheme ? TrackTheme.alpha(theme.heat5, 0.24) : 'rgba(62,207,142,0.22)') : 'var(--border)'};
                  background:${day.inCurrentMonth ? heatColor(day.horas, day.inRange) : 'var(--surface-subtle)'};
                  color:${day.inCurrentMonth ? heatTextColor(day.horas, day.inRange) : 'var(--text3)'};
                  box-shadow:${day.horas > 0 && day.inCurrentMonth && day.inRange ? 'inset 0 1px 0 var(--surface-strong), 0 10px 20px ' + (window.TrackTheme ? TrackTheme.alpha(theme.heat4, 0.12) : 'rgba(47,189,123,0.08)') : 'none'};
                  display:flex;
                  flex-direction:column;
                  justify-content:space-between;
                `;
              const content = `
                <div style="font-size:10px;font-weight:700;line-height:1">${day.day}</div>
                <div style="font-size:9px;line-height:1;text-align:left;color:${day.horas > 0 && day.inCurrentMonth && day.inRange ? heatTextColor(day.horas, day.inRange) : 'transparent'}">${day.horas > 0 && day.inCurrentMonth && day.inRange ? formatHoursAsStudyTime(day.horas) : '&nbsp;'}</div>
              `;
              if (!day.inCurrentMonth) {
                return `
                  <div
                    class="heatmap-day-out"
                    onclick="event.stopPropagation()"
                    title="Fora de ${month.title}/${month.year}"
                    style="${commonStyle}"
                  >${content}</div>
                `;
              }
              return `
                <button
                  type="button"
                  class="heatmap-day-btn"
                  onclick="event.stopPropagation(); openDayDetail('${day.key}')"
                  onkeydown="event.stopPropagation()"
                  title="${formatHeatmapDate(day.key)} - ${formatHoursAsStudyTime(day.horas)}"
                  style="${commonStyle}"
                >${content}</button>
              `;
            }).join('')}
          </div>
        </div>
      `).join('')}
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:18px">
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;color:var(--text3);font-size:11px">
        <span>${totalDiasComEstudo} dias com estudo</span>
        <span>Maior carga: ${formatHoursAsStudyTime(maiorCarga)}</span>
      </div>
      ${annualControl}
      <div style="display:flex;align-items:center;gap:6px;color:var(--text3);font-size:11px">
        <span>Menos</span>
        <span style="width:14px;height:14px;border-radius:4px;background:${theme.heatEmpty};border:1px solid var(--border)"></span>
        <span style="width:14px;height:14px;border-radius:4px;background:${theme.heat1};border:1px solid ${window.TrackTheme ? TrackTheme.alpha(theme.heat5, 0.12) : 'rgba(62,207,142,0.12)'}"></span>
        <span style="width:14px;height:14px;border-radius:4px;background:${theme.heat2};border:1px solid ${window.TrackTheme ? TrackTheme.alpha(theme.heat5, 0.12) : 'rgba(62,207,142,0.12)'}"></span>
        <span style="width:14px;height:14px;border-radius:4px;background:${theme.heat3};border:1px solid ${window.TrackTheme ? TrackTheme.alpha(theme.heat5, 0.12) : 'rgba(62,207,142,0.12)'}"></span>
        <span style="width:14px;height:14px;border-radius:4px;background:${theme.heat5};border:1px solid ${window.TrackTheme ? TrackTheme.alpha(theme.heat5, 0.12) : 'rgba(62,207,142,0.12)'}"></span>
        <span>Mais</span>
      </div>
    </div>
  `;
}

function render() {
  const c = CT.getConcurso(cId);
  if (!c) return;

  if (_janela === 0) {
    document.getElementById('histSub').textContent = c.nome + ' — todos os dias';
  } else {
    document.getElementById('histSub').textContent = c.nome + ' — últimos ' + _janela + ' dias';
  }
  document.querySelector('.concurso-nome').textContent = c.nome;
  document.querySelector('.concurso-banca').textContent = c.banca || '—';

  // Gera array de datas
  const datas = [];
  if (_janela === 0) {
    // Todos: encontra a data mais antiga entre sessões e questões
    const todasS = CT.getSessoes({ concursoId: cId });
    const todasQ = CT.getQuestoes({ concursoId: cId });
    const allDates = [...todasS.map(s => s.data), ...todasQ.map(q => q.data)].filter(Boolean).sort();
    if (allDates.length > 0) {
      const inicio = new Date(allDates[0] + 'T12:00:00');
      const hoje = new Date(); hoje.setHours(12,0,0,0);
      for (let d = new Date(inicio); d <= hoje; d.setDate(d.getDate() + 1)) {
        datas.push(CT._dateString(d));
      }
    }
  } else {
    for (let i = _janela - 1; i >= 0; i--) {
      const d = new Date(); d.setHours(12,0,0,0); d.setDate(d.getDate() - i);
      datas.push(CT._dateString(d));
    }
  }
  const labels = datas.map(d => { const p=d.split('-'); return p[2]+'/'+p[1]; });

  // Sessões e questões por dia
  const todasSessoes  = CT.getSessoes({ concursoId: cId });
  const todasQuestoes = CT.getQuestoes({ concursoId: cId });

  const horasPorDia    = datas.map(d => CT.totalSegundos(todasSessoes.filter(s=>s.data===d))/3600);
  const questoesPorDia = datas.map(d => CT.calcStats(todasQuestoes.filter(q=>q.data===d)).resolvidas || 0);
  const datasSet = new Set(datas);

  const totalHorasPeriodo   = horasPorDia.reduce((a,b)=>a+b,0);
  const totalQuestoesPeriodo = questoesPorDia.reduce((a,b)=>a+b,0);
  const diasAtivos = horasPorDia.filter(h=>h>0).length;

  // Stats globais
  const topicos   = CT.getTopicos().filter(t=>t.concursoId===cId);
  const estudados = topicos.filter(t=>t.estudado).length;
  const qAll      = CT.calcStats(todasQuestoes);
  const segTotal  = CT.totalSegundos(todasSessoes);

  document.getElementById('statsGlobais').innerHTML = [
    { icon:'timer',     val: CT.formatarTempo(segTotal)||'0h', label:'Horas totais',       color:'var(--accent)',  iconColor:'var(--accent)' },
    { icon:'questions', val: qAll.resolvidas||0,               label:'Questões no total',  color:'var(--yellow)',  iconColor:'var(--accent2)' },
    { icon:'target-color', val: qAll.pct!=null?qAll.pct+'%':'—',  label:'Taxa de acertos',    color:pctColor(qAll.pct), iconColor:'var(--green)' },
    { icon:'task',      val: estudados+'/'+topicos.length,     label:'Tópicos concluídos', color:'var(--accent2)', iconColor:'var(--green)' },
  ].map(s=>`
    <div class="metrics-stat-card">
      <div class="metrics-stat-main">
        <span class="metrics-stat-icon" data-stat-icon="${s.icon}" aria-hidden="true" style="color:${s.iconColor}"></span>
        <div class="metrics-stat-value" style="color:${s.color}">${escapeHtml(s.val)}</div>
      </div>
      <div class="metrics-stat-label">${escapeHtml(s.label)}</div>
    </div>`).join('');

  // Labels subheader
  document.getElementById('lblHoras').textContent =
    formatStudyTime(totalHorasPeriodo * 3600) + ' em ' + diasAtivos + ' dias ativos';
  document.getElementById('lblQuestoes').textContent =
    totalQuestoesPeriodo + ' questões no período';

  // Heatmap de horas
  if (_chartHoras) _chartHoras.destroy();
  _chartHoras = null;
  renderHorasHeatmap(document.getElementById('chartHoras'), datas, horasPorDia);

  // Chart questões
  const ctxQ = document.getElementById('chartQuestoes').getContext('2d');
  if (_chartQuestoes) _chartQuestoes.destroy();
  _chartQuestoes = null;

  // Gráfico Pizza — distribuição por matéria
  const materias = CT.getMaterias(cId);
  const desempenhoMaterias = materias.map(m => {
    const questoesMateriaPeriodo = todasQuestoes.filter(q => q.materiaId === m.id && datasSet.has(q.data));
    const stats = CT.calcStats(questoesMateriaPeriodo);
    return {
      id: m.id,
      nome: m.nome,
      resolvidas: stats.resolvidas || 0,
      acertos: stats.acertos || 0,
      pct: stats.pct
    };
  }).filter(m => m.resolvidas > 0);

  document.getElementById('lblQuestoes').textContent = desempenhoMaterias.length
      ? desempenhoMaterias.length + ' matérias com questões no período'
      : 'Sem questões suficientes no período';

  const rankingChart = [...desempenhoMaterias]
    .sort((a,b) => {
      if ((b.pct || 0) !== (a.pct || 0)) return (b.pct || 0) - (a.pct || 0);
      return b.resolvidas - a.resolvidas;
    })
    .slice(0, 6);
  const theme = themePalette();

  if (rankingChart.length) {
    _chartQuestoes = new Chart(ctxQ, {
      type: 'bar',
      data: {
        labels: rankingChart.map(m => m.nome.length > 22 ? m.nome.slice(0, 22) + '...' : m.nome),
        datasets: [{
          data: rankingChart.map(m => m.pct),
          backgroundColor: rankingChart.map(m => {
            const pct = m.pct || 0;
            if (pct >= 93) return 'rgba(52,245,141,0.82)';
            if (pct >= 80) return 'rgba(156,247,204,0.82)';
            if (pct >= 75) return 'rgba(255,228,92,0.82)';
            if (pct >= 50) return 'rgba(245,135,74,0.82)';
            return 'rgba(245,90,90,0.82)';
          }),
          borderColor: rankingChart.map(m => pctColor(m.pct)),
          borderWidth: 1.5,
          borderRadius: 8,
          borderSkipped: false,
          barThickness: 16
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: theme.tooltipBg,
            borderColor: theme.tooltipBorder,
            borderWidth: 1,
            titleColor: theme.tooltipTitle,
            bodyColor: theme.tooltipBody,
            padding: 10,
            cornerRadius: 8,
            callbacks: {
              label: function(ctx) {
                const item = rankingChart[ctx.dataIndex];
                return ' ' + item.pct + '% | ' + item.acertos + '/' + item.resolvidas + ' acertos';
              }
            }
          }
        },
        scales: {
          x: {
            min: 0,
            max: 100,
            ticks: {
              color: theme.chartAxis,
              font:{size:10},
              callback: function(value) { return value + '%'; }
            },
            grid: { color: theme.chartGrid }
          },
          y: {
            ticks: { color: theme.chartAxisStrong, font:{size:11, weight:'600'} },
            grid: { display:false }
          }
        }
      }
    });
  } else {
    ctxQ.clearRect(0, 0, ctxQ.canvas.width, ctxQ.canvas.height);
    _chartQuestoes = null;
  }

  const topFacilidade = [...desempenhoMaterias]
    .sort((a,b) => {
      if ((b.pct || 0) !== (a.pct || 0)) return (b.pct || 0) - (a.pct || 0);
      return b.resolvidas - a.resolvidas;
    })
    .slice(0, 3);

  const topDificuldade = [...desempenhoMaterias]
    .sort((a,b) => {
      if ((a.pct || 0) !== (b.pct || 0)) return (a.pct || 0) - (b.pct || 0);
      return b.resolvidas - a.resolvidas;
    })
    .slice(0, 3);

  function renderResumoMaterias(titulo, color, items, emptyText) {
    return `
      <div style="background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:14px 16px">
        <div style="font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:${color};margin-bottom:10px">${titulo}</div>
        ${items.length ? items.map(item => `
          <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05)">
            <div style="flex:1;min-width:0">
              <div style="font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${item.nome}</div>
              <div style="font-size:11px;color:var(--text3);margin-top:2px">${item.acertos}/${item.resolvidas} acertos</div>
            </div>
            <div style="font-family:var(--mono);font-size:15px;font-weight:800;color:${pctColor(item.pct)}">${item.pct}%</div>
          </div>
        `).join('') : `<div style="font-size:12px;color:var(--text3);padding:8px 0">${emptyText}</div>`}
      </div>
    `;
  }

  document.getElementById('analiseMateriasResumo').innerHTML = [
    renderResumoMaterias('Maior facilidade', '#9cf7cc', topFacilidade, 'Resolva questões no período para aparecer aqui.'),
    renderResumoMaterias('Maior dificuldade', 'var(--orange)', topDificuldade, 'Resolva questões no período para aparecer aqui.')
  ].join('');
  const ranking = materias.map(m => {
    const seg = CT.totalSegundos(CT.getSessoes({ concursoId: cId, materiaId: m.id }));
    const q   = CT.calcStats(CT.getQuestoes({ materiaId: m.id }));
    const tops = CT.getTopicos(m.id);
    const est  = tops.filter(t=>t.estudado).length;
    return { nome: m.nome, seg, q, est, total: tops.length };
  }).sort((a,b)=>b.seg-a.seg);

  const totalSeg = ranking.reduce((a,m)=>a+m.seg,0);
  const pizzaLabels = ranking.map(m => m.nome);
  const pizzaData   = ranking.map(m => parseFloat((m.seg/3600).toFixed(2)));
  const paletteColors = getPizzaColors();
  const pizzaColors   = ranking.map((_,i) => paletteColors[i % paletteColors.length]);
  _pizzaShareState = prepararEstadoCompartilhamentoPizza(c, ranking, totalSeg, paletteColors);

  document.getElementById('lblPizza').textContent = totalSeg > 0
    ? CT.formatarTempo(totalSeg) + ' no total'
    : 'Nenhuma sessão registrada';

  const ctxP = document.getElementById('chartPizza').getContext('2d');
  if (_chartPizza) _chartPizza.destroy();

  if (totalSeg > 0) {
    _chartPizza = new Chart(ctxP, {
      type: 'doughnut',
      data: {
        labels: pizzaLabels,
        datasets: [{
          data: pizzaData,
          backgroundColor: pizzaColors,
          borderColor: theme.chartSurfaceBorder,
          borderWidth: 2,
          hoverOffset: 8,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        cutout: '55%',
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: theme.tooltipBg,
            borderColor: window.TrackTheme ? TrackTheme.alpha(theme.accent, 0.3) : 'rgba(79,142,247,0.3)',
            borderWidth: 1,
            titleColor: theme.tooltipTitle,
            bodyColor: theme.tooltipBody,
            padding: 10,
            cornerRadius: 8,
            callbacks: {
              label: function(ctx) {
                const pct = totalSeg > 0 ? Math.round((ranking[ctx.dataIndex].seg / totalSeg) * 100) : 0;
                return ' ' + formatStudyTime(ranking[ctx.dataIndex].seg) + ' (' + pct + '%)';
              }
            }
          }
        }
      }
    });
  } else {
    // Limpa o canvas se não houver dados
    ctxP.clearRect(0, 0, ctxP.canvas.width, ctxP.canvas.height);
    _chartPizza = null;
  }

  // Legenda customizada ao lado da pizza
  document.getElementById('pizzaLegend').innerHTML = ranking.length > 0
    ? ranking.map((m, i) => {
        const pct = totalSeg > 0 ? Math.round((m.seg / totalSeg) * 100) : 0;
        return `
        <div style="display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid var(--border)">
          <div style="width:10px;height:10px;border-radius:3px;flex-shrink:0;background:${paletteColors[i % paletteColors.length]}"></div>
          <div style="flex:1;min-width:0">
            <div style="font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.nome}</div>
          </div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--text3);flex-shrink:0">${CT.formatarTempo(m.seg)||'0min'}</div>
          <div style="font-family:var(--mono);font-size:11px;font-weight:700;color:${paletteColors[i % paletteColors.length]};flex-shrink:0;width:32px;text-align:right">${pct}%</div>
        </div>`;
      }).join('')
    : '<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">Nenhuma sessão registrada ainda.</div>';

  const hojeKey = CT._today();
  const sessoesHoje = todasSessoes
    .filter(s => s.data === hojeKey)
    .sort((a,b) => String(b.horaInicio || '').localeCompare(String(a.horaInicio || '')));
  const questoesHoje = todasQuestoes.filter(q => q.data === hojeKey);
  const totalSegHoje = CT.totalSegundos(sessoesHoje);
  const statsHoje = CT.calcStats(questoesHoje);
  const colorByMateria = new Map();
  ranking.forEach((m, i) => colorByMateria.set(m.nome, paletteColors[i % paletteColors.length]));
  const horasHojeByMateria = materias.map((m, i) => {
    const segMateria = CT.totalSegundos(sessoesHoje.filter(s => s.materiaId === m.id));
    return {
      label: m.nome,
      value: segMateria,
      color: colorByMateria.get(m.nome) || paletteColors[i % paletteColors.length],
      pct: totalSegHoje > 0 ? Math.round((segMateria / totalSegHoje) * 100) : 0
    };
  }).filter(item => item.value > 0);
  _todayShareState = prepararEstadoEstudosDia(c, hojeKey, totalSegHoje, statsHoje, sessoesHoje, horasHojeByMateria);
  const questoesHojeItens = [
    { label: 'Certas', value: statsHoje.acertos || 0, color: theme.green, pct: statsHoje.resolvidas > 0 ? Math.round(((statsHoje.acertos || 0) / statsHoje.resolvidas) * 100) : 0 },
    { label: 'Erradas', value: statsHoje.erros || 0, color: theme.red, pct: statsHoje.resolvidas > 0 ? Math.round(((statsHoje.erros || 0) / statsHoje.resolvidas) * 100) : 0 }
  ].filter(item => item.value > 0);

  document.getElementById('todaySummarySub').textContent = `Hoje (${hojeKey.split('-').reverse().join('/')})`;
  document.getElementById('todayHoursSub').textContent = totalSegHoje > 0
    ? formatStudyTime(totalSegHoje) + ' estudados hoje'
    : 'Nenhuma hora registrada hoje';
  document.getElementById('todayQuestionsSub').textContent = statsHoje.resolvidas > 0
    ? statsHoje.resolvidas + ' questões feitas hoje'
    : 'Nenhuma questão registrada hoje';
  document.getElementById('todaySessionsSub').textContent = '';
  document.getElementById('todayHoursLegend').innerHTML = buildLegendRows(horasHojeByMateria, item => formatStudyTime(item.value), 'Nenhuma sessão de estudo hoje.');
  document.getElementById('todayQuestionsLegend').innerHTML = buildLegendRows(questoesHojeItens, item => String(item.value), 'Nenhuma questão feita hoje.');
  document.getElementById('todaySessionsList').innerHTML = sessoesHoje.length
    ? sessoesHoje.map(s => {
        const mat = s.materiaId ? CT.getMateria(s.materiaId) : null;
        const hora = s.horaInicio ? new Date(s.horaInicio).toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' }) : '--:--';
        const tipoEstudo = formatStudyTypeLabel(s);
        const metricas = CT.formatarResumoMetricasSessao ? CT.formatarResumoMetricasSessao(s) : '';
        const metaSessao = [tipoEstudo, metricas].filter(Boolean).join(' | ');
        return `
          <div class="today-session-item">
            <div class="today-session-hour">${hora}</div>
            <div style="min-width:0">
              <div class="today-session-name">${mat ? mat.nome : 'Sessão livre'}</div>
              ${metaSessao ? `<div class="today-session-meta">${escapeHtml(metaSessao)}</div>` : ''}
            </div>
            <div class="today-session-duration">${formatStudyTime(s.duracaoSegundos)}</div>
          </div>`;
      }).join('')
    : '<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">Nenhuma sessão de estudo hoje.</div>';

  _chartTodayHours = makeDoughnutChart(
    'chartTodayHours',
    _chartTodayHours,
    horasHojeByMateria.map(item => ({ label: item.label, value: Number((item.value / 3600).toFixed(2)), color: item.color, rawSeconds: item.value, pct: item.pct })),
    theme,
    item => `${item.label}: ${formatStudyTime(item.rawSeconds)} (${item.pct}%)`
  );
  _chartTodayQuestions = makeDoughnutChart(
    'chartTodayQuestions',
    _chartTodayQuestions,
    questoesHojeItens,
    theme,
    item => `${item.label}: ${item.value} (${item.pct}%)`
  );
}

document.getElementById('todayShareBtn')?.addEventListener('click', function(event) {
  event.stopPropagation();
  abrirPopupEstudosDia();
});
render();
