/**
 * Track do Oodeus - [R10-port] IIFE sidebar de revisoes.html (verbatim,
 * linhas 328-382 do original www/revisoes.html). Idêntica às outras páginas
 * (logo cache-bust, PRÉ-EDITAL reescreve o timer-box, Pós-Edital reescreve
 * com "Coberto ×N", revBadge por concurso; mesma fonte multilinha de
 * simulados/historico). Sem seams — não navega. Roda como 1º script da
 * cadeia (o data.js do original 326 roda no onload do plugin). A
 * duplicação badge/concurso-nome/banca com render() é viva e replicada.
 */
// ── SIDEBAR CONCURSO ─────────────────────
(function() {
  const cId = sessionStorage.getItem('ct_concurso_ativo');
  if (!cId) return;
  const c = CT.getConcurso(cId);
  if (!c) return;
  const nomeEl  = document.getElementById('sideNome');
  const bancaEl = document.getElementById('sideBanca');
  const timerEl = document.getElementById('sideTimer');
  const timerLb = document.getElementById('sideTimerLabel');
  const logoEl  = document.getElementById('sideLogoImg');
  if (nomeEl)  nomeEl.textContent  = c.nome;
  if (bancaEl) bancaEl.textContent = c.banca || '—';
  if (logoEl) {
    let logoHtml = '';
    if (c.logoPath) logoHtml = `<img src="${c.logoPath}?t=${Date.now()}" style="width:100%;height:100%;object-fit:cover;border-radius:5px">`;
    else if (c.logoBase64) logoHtml = `<img src="${c.logoBase64}" style="width:100%;height:100%;object-fit:cover;border-radius:5px">`;
    else if (c.logoEmoji) logoHtml = c.logoEmoji;
    logoEl.innerHTML = logoHtml;
  }
  if (c.preEdital) {
    if (timerEl) {
      const box = timerEl.parentElement;
      box.style.padding = '12px 12px 10px';
      box.innerHTML = '<div style="display:flex; flex-direction:column; align-items:center; gap:6px">'
          + '<div style="font-size:12px; font-weight:700; color:var(--accent2); text-transform:uppercase; letter-spacing:1.5px">✦ PRÉ-EDITAL</div>'
          + '<div style="display:flex; align-items:center; justify-content:center; gap:8px; font-size:16px; font-weight:600; color:var(--text3)">'+(CT.renderCoverageRocket ? CT.renderCoverageRocket(c, 30, 'vertical-align:0;') : '🚀')+' <span style="color:var(--text)">coberto</span> <span style="color:var(--accent2); font-weight:800">×'+(c.coberto||0)+'</span></div>'
          + '</div>';
    }
  } else {
    const dias = CT.diasRestantes(c);
    if (timerEl) {
      const box = timerEl.parentElement;
      box.style.padding = '8px 10px';
      var cobHtml = (c.coberto > 0)
        ? '<div style="margin-top:5px; border-top:1px solid var(--border); padding-top:5px; display:flex; flex-direction:column; align-items:center;">'
          + '<div style="font-size:10px; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:0.5px">✦ Pós-Edital</div>'
          + '<div style="font-size:11px; font-weight:600; color:var(--text3)">'+(CT.renderCoverageRocket ? CT.renderCoverageRocket(c, 18) : '🚀')+' Coberto <span style="color:var(--accent2)">×'+c.coberto+'</span></div>'
          + '</div>'
        : '';
      box.innerHTML = '<div class="timer-num" id="sideTimer">'+(dias!=null?dias:'—')+'</div><div class="timer-label" id="sideTimerLabel">dias para a prova</div>' + cobHtml;
      document.getElementById('sideTimer').style.color = dias==null?'var(--accent)':dias<=7?'var(--red)':dias<=30?'var(--orange)':'var(--accent)';
    }
  }
  // Rev badge
  const rev = CT.classificarRevisoes ? CT.classificarRevisoes() : null;
  if (rev) {
    const urgentes = [...(rev.atrasadas||[]), ...(rev.hoje||[])].filter(r => {
      const ctx = CT.getContextoRevisao(r);
      return ctx.concursoId === cId;
    }).length;
    const b = document.getElementById('revBadge');
    if (b) { b.textContent=urgentes; b.style.display=urgentes>0?'':'none'; }
  }
})();
